// ───────────────────────── Audit ─────────────────────────

// `tenantId` is nullable on purpose: a KVKK/GDPR erasure request from a user
// who belongs to no tenant still has to leave a trail
// (src/actions/user/request-deletion.ts). So this table takes the
// `tenant_or_shared` policy, not `tenant_isolation` — under strict isolation
// `NULL = 'x'` is not true and that row could be neither written nor read
// (TASK-MTU6HUB8FUHMG C-2).
model AuditEvent {
  id        String @db.VarChar(128)   @id @default(cuid())
  tenantId  String? @db.VarChar(128)
  actorId   String? @db.LongText
  type      String   // module.state.changed | gate.decided | subscription.updated | ...
  target    String?
  data      Json?
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
  @@map("v_AuditEvent")
}

// The idempotency key of a payment-provider webhook delivery (ADR-0003).
//
// This used to be an `AuditEvent` row, found by `data->>'stripeEventId'`. That
// worked only because the app connects as a BYPASSRLS role: `AuditEvent` carries
// the `tenant_or_shared` policy, so under `fabrika_app` the key could neither be
// written nor read outside a tenant transaction — and it was written last, after
// the money. A webhook therefore granted credits, failed to record the key, and
// Stripe's redelivery re-ran the whole handler (TASK-MTVSBEO7VX6Y4, measured).
//
// Three things changed here, and each one is the reason a column exists:
//   • `tenantId` is NOT NULL, so this table takes the plain `tenant_isolation`
//     policy and lives inside `withTenant` with the money it guards.
//   • `stripeEventId` is UNIQUE, so a *second* concurrent delivery of the same
//     event is refused by Postgres rather than by a read-then-write guard that
//     both deliveries pass. That race was the open gap the old guard's own
//     docstring admitted to.
//   • the lock is no longer the audit trail. `AuditEvent` rows are still written
//     for every event; deleting one no longer unlocks a replay.
//
// `handler` names which webhook wrote it, so a replay can be attributed without
// joining back to the audit trail.
model StripeEventLog {
  id            String @db.VarChar(128)   @id @default(cuid())
  tenantId      String @db.VarChar(128)
  stripeEventId String   @unique
  handler       String @db.LongText   // subscription.sync | subscription.cancel | invoice.payment
  processedAt   DateTime @default(now())
  @@index([tenantId, processedAt])
  @@map("v_StripeEventLog")
}

// ADR-0011 (TASK-MUVR24EHWI2RA). One row per recipient: `readAt` is that
// user's read state, so there is no per-workspace or browser-side copy of it
// (K-1 a, K-2 a). Tenant isolation is RLS (`tenant_isolation`, prisma/rls.sql);
// user isolation is the `userId` filter every read and write in
// src/lib/notifications/store.ts carries (K-5 a). `payload` holds ids and
// counts only; the text is rendered from `type` + `payload` with next-intl.
// Deleted after NOTIFICATION_RETENTION_DAYS (90, K-3 a) by
// `notifications-retention`, with the user (users-scheduled-deletion) and with
// the tenant (cascade). Migration: add-notification.sql.
model Notification {
  id          String @db.VarChar(128)           @id @default(cuid())
  tenantId    String @db.VarChar(128)
  userId      String           // recipient; User.id, no FK (SavedSearch.userId pattern)
  workspaceId String? @db.LongText          // NULL = tenant-wide (both MVP producers)
  type        NotificationType
  payload     Json             @default("{}")
  dedupeKey   String?          // same event twice -> one row (@@unique below)
  createdAt   DateTime         @default(now())
  readAt      DateTime?        // NULL = unread

  @@unique([tenantId, userId, dedupeKey])
  @@index([tenantId, userId, readAt, createdAt])
  @@index([createdAt])
  @@map("v_Notification")
}

enum NotificationType {
  SAVED_SEARCH_MATCH   // payload: { searchId, searchName, matchCount, since }
  CREDIT_GRANTED       // payload: { amount, period?, source } (no producer yet)
  CREDIT_EXHAUSTED     // payload: { module } (no producer yet)
  EVIDENCE_EXPIRING    // payload: { evidenceId, validUntil } (evidence-expiring job)
}

// ───────────────────────── v1.1+ (M6, M9, M10, M11, M7) ─────────────────────────


// M6 Evaluator Lens.
// Two shapes share this table, distinguished by `readerType`:
//   HUMAN | AI    — single-reader lens on an Opportunity (v1.0, excellence/impact/implementation)
//   PANEL         — multi-reviewer panel on a Proposal (v1.1, reviewers + criteria + scores)
// The v1.1 columns are all nullable or defaulted, so existing v1.0 rows and callers are unaffected.
model Evaluation {
  id             String @db.VarChar(128)      @id @default(cuid())
  tenantId       String @db.VarChar(128)
  opportunityId  String @db.VarChar(128)
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  proposalId     String? @db.VarChar(128)     // v1.1 — set for PANEL evaluations
  proposal       Proposal?   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId         String? @db.VarChar(128)     // owning evaluator / creator
  readerType     String @db.LongText      @default("HUMAN") // "HUMAN" | "AI" | "PANEL"
  status         String      @default("draft") // draft | in-progress | completed
  avgScore       Float?      // weighted 1-5 panel average; null until reviewers submit
  excellence     Float       @default(0)
  impact         Float       @default(0)
  implementation Float       @default(0)
  weaknesses     Json?
  calibration    Float?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  reviewers      Reviewer[]
  criteria       Criterion[]
  @@index([tenantId, proposalId])
  @@index([tenantId, opportunityId])
  @@map("v_Evaluation")
}

// One assigned reviewer on a PANEL evaluation. A user may sit on an evaluation once.
model Reviewer {
  id           String @db.VarChar(128)     @id @default(cuid())
  tenantId     String @db.VarChar(128)
  evaluationId String @db.VarChar(128)
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  userId       String @db.VarChar(128)
  role         String     @default("evaluator") // evaluator | coordinator
  status       String     @default("pending")   // pending | completed
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  scores       Score[]
  @@unique([evaluationId, userId])
  @@index([evaluationId, status])
  @@index([tenantId])
  @@map("v_Reviewer")
}

// A weighted scoring axis of a PANEL evaluation. Weights are 0..1 and should sum to 1 per evaluation.
model Criterion {
  id           String @db.VarChar(128)     @id @default(cuid())
  tenantId     String @db.VarChar(128)
  evaluationId String @db.VarChar(128)
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  name         String @db.VarChar(200)     // Innovation | Feasibility | Impact | Communication
  weight       Float      @default(0)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  scores       Score[]
  @@unique([evaluationId, name])
  @@index([tenantId, evaluationId])
  @@map("v_Criterion")
}

// One reviewer's mark on one criterion. score is 1..5 (DB CHECK in the M6 migration).
// submittedAt stays null while the reviewer is still drafting.
model Score {
  id          String @db.VarChar(128)    @id @default(cuid())
  tenantId    String @db.VarChar(128)
  reviewerId  String @db.VarChar(128)
  reviewer    Reviewer  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  criterionId String @db.VarChar(128)
  criterion   Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  score       Int
  comment     String?   @db.LongText
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  @@unique([reviewerId, criterionId])
  @@index([criterionId])
  @@index([tenantId])
  @@map("v_Score")
}

model MeetingBrief {
  id                  String @db.VarChar(128)      @id @default(cuid())
  tenantId            String @db.VarChar(128)
  interactionId       String      @unique
  partnerName         String? @db.LongText
  content             String
  meetingScheduledAt  DateTime?   // UTC meeting time
  meetingScheduledTz  String @db.LongText      @default("Europe/Brussels")
  createdAt           DateTime    @default(now())
  // The opportunity the brief was prepared for (add-meeting-brief-opportunity.sql).
  // NULL = "not linked to an opportunity": every brief written before the column
  // existed. SetNull, not Cascade: a brief is the user's own text and outlives
  // a hard-deleted opportunity. The FK does not check tenants (constraint checks
  // bypass RLS), so generateMeetingBrief refuses an id outside the session tenant.
  opportunityId       String? @db.VarChar(128)
  opportunity         Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId], map: "MeetingBrief_tenantId") // add-m9-meeting-schedule/migration.sql
  @@index([tenantId, opportunityId])
  @@map("v_MeetingBrief")
}

model CalendarConnection {
  id                String @db.VarChar(128)    @id @default(cuid())
  tenantId          String @db.VarChar(128)
  userId            String
  provider          String    // 'google' | 'outlook' | 'ics'
  externalId        String? @db.LongText   // Google: calendar ID, Outlook: mailbox address
  accessToken       String? @db.LongText   // Plaintext. Column is unpopulated today — no OAuth writer exists yet
                               // (google/outlook `connectCalendar` refuses with CALENDAR_OAUTH_NOT_CONFIGURED,
                               // `/api/calendar/callback` does not exist). Must be encrypted before that
                               // OAuth flow ships — see docs/ROADMAP.md open decision #12, TASK-MTSHP3BMTAD3Y.
  refreshToken      String? @db.LongText   // Same as accessToken above.
  tokenExpiresAt    DateTime?
  isConnected       Boolean   @default(true)
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

