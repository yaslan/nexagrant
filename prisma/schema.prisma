// ───────────────────────── K5 Pipeline (tenant-scoped) ─────────────────────────

model Opportunity {
  id           String   @id @default(cuid())
  tenantId     String
  workspaceId  String
  topicId      String?
  title        String
  stage        Gate     @default(G0)
  status       OppStatus @default(ACTIVE)
