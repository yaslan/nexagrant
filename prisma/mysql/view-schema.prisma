model FollowupDoc {
  id             String @db.VarChar(128)      @id @default(cuid())
  tenantId       String @db.VarChar(128)
  opportunityId  String @db.VarChar(128)
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  kind           String      // NDA, LOI, COMMITMENT, ESR_DEBRIEF, AWARD_PACK
  version        Int         @default(1)
  contentUrl     String? @db.LongText
  signedAt       DateTime?
  createdAt      DateTime    @default(now())

  // M10 dual approval — the submission that opens the flow (TASK-MTSAIWF4ENUSL).
  // The two department sign-offs live in DualApprovalStep; the final signature is
  // `signedAt` above. `approvalSubmittedByName` is a snapshot of the display name
  // as the session carried it, so the record stays readable after a rename.
  approvalSubmittedAt     DateTime?
  approvalSubmittedById   String? @db.LongText
  approvalSubmittedByName String? @db.LongText

  approvalSteps  DualApprovalStep[]
  @@map("v_FollowupDoc")
