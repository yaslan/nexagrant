  ownerId      String?
  g0Score      Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proposal     Proposal?
  gateDecisions GateDecision[]
  seats        ConsortiumSeat[]
  efforts      Effort[]
  topicMatches TopicMatch[]
  @@index([tenantId, workspaceId, stage])
  followupDocs FollowupDoc[]
  applicationParts ApplicationPart[]
  evaluations Evaluation[]
  meetingBriefs MeetingBrief[]
  internalApproval InternalApproval?
  decisionLog  DecisionLog[]
  @@unique([id, tenantId])
  @@index([deletedAt])
}

enum Gate {
  G0
  G1
  G2
  G3
  G4
}
enum OppStatus {
  ACTIVE
