#!/bin/bash
# psql shim -> docker exec befb-vw-pg
args=(); stdin_file=""; url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -f) stdin_file="$2"; shift 2;;
    postgres*://*) url="$1"; shift;;
    x) shift;;
    *) args+=("$1"); shift;;
  esac
done
[ -z "$url" ] && url="postgresql://fabrika:fabrika@localhost:5432/fabrika"
url=$(printf '%s' "$url" | sed -E 's#@[^/]*/#@localhost:5432/#')
if [ -n "$stdin_file" ]; then docker exec -i -e PGOPTIONS="$PGOPTIONS" befb-vw-pg psql "$url" "${args[@]}" -f - < "$stdin_file"
else docker exec -i -e PGOPTIONS="$PGOPTIONS" befb-vw-pg psql "$url" "${args[@]}"; fi
