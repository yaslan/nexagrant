# --- App ---
NODE_ENV=development
# Reported with each feedback submission (src/app/api/feedback/route.ts). Blank = null.
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# LIVE (patron, 29.09): NEXT_PUBLIC_APP_URL=https://fonbridge.com
# Every link the app builds to itself is read from it (src/lib/app-url.ts). Give
# the origin only: https://host, no path, ?query or #fragment. In production an
# unset, localhost, http:// or non-origin value writes an error SystemAlert at
# startup; Google Calendar connect and invitation mails stay off until it is fixed
# (other links fall back to https://fonbridge.com).
# Redirect URIs to register in the Google Cloud OAuth client for the live domain:
#   sign-in (Auth.js): https://fonbridge.com/api/auth/callback/google
#   calendar:          https://fonbridge.com/api/calendar/callback
DEFAULT_LOCALE=tr

# --- Database (Postgres 16 + pgvector) ---
# Port 5433 = docker-compose.yml's default (FABRIKA_PG_PORT). 5432 is left free
# because another project's Postgres may already hold it.
DATABASE_URL=postgresql://fabrika:fabrika@localhost:5433/fabrika
DATABASE_URL_MIGRATE=postgresql://fabrika_migrate:fabrika@localhost:5433/fabrika
# RLS-subject role (NOSUPERUSER, NOBYPASSRLS). Created by `pnpm db:rls-role`, which
# generates the password and appends the real value to .env — but only while this
# key is ABSENT; if it is set, the script uses its password as-is. So it stays
# commented out here. Used by the live RLS tests (tests/helpers/live-db-role.ts) —
# the app itself still connects as DATABASE_URL.
# DATABASE_URL_RLS_TEST=postgresql://fabrika_app:<generated>@localhost:5433/fabrika

# --- Auth.js ---
# Required (32+ characters): the server refuses to start without it, and
# `docker compose` refuses every command while it is empty (fabrika-web needs it).
# Generate: openssl rand -base64 32   — see README "Yerel çalıştırma".
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Legacy names, read only when the AUTH_* key above is blank (src/lib/auth.ts).
# Prefer AUTH_SECRET / AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET.
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Auth.js builds its callback from the request host (trustHost). Behind a proxy
# that rewrites Host, pin it: AUTH_URL=https://fonbridge.com
# How many reverse proxies OF OURS sit in front of the app (nginx/Caddy of
# docs/SMTP-SUNUCU.md §10.1 = 1). The per-IP limit of the contact form reads the
# X-Forwarded-For entry this many places from the RIGHT: entries to its left were
# written by the client and are ignored (src/lib/leads/public-lead.ts clientIpFrom).
# CDN in front of nginx = 2. 0 = no proxy: no IP is trusted, only the per-address
# limit applies. Must match the real topology — one too many and the limit counts
# the client's forged value again; also keep port 3000 unreachable from outside
# (docker-compose.yml binds it to 127.0.0.1 and passes this value, default 1).
# Only a plain 0..5 is accepted; anything else is logged and read as 1.
TRUSTED_PROXY_HOPS=1
# Password-less e-mail and one-click demo sign-in (src/lib/demo-login.ts).
# `true` = anyone who types an address signs in as that account, an unknown address
# creates one, and admin@yasinaslan.com.tr is a platform admin. Local/demo only.
# Unset or `false` = off: only the OAuth providers above, platform admin only from
# the database. A production build (`next build`) or NODE_ENV=production REFUSES TO
# START while it is `true`, whatever NODE_ENV the server is started with.
# Off by default. For local development with the demo seats, set it to `true`
# in your own .env (the e2e run sets it itself, see playwright.config.ts).
DEMO_LOGIN_ENABLED=false

# --- Scheduled jobs (graphile-worker, ADR-0008) ---
# `pnpm jobs:worker` runs them: a long-running process next to the web app,
# any number of copies against one database (each cron tick still runs once).
# JOBS_CRON_ENABLED: blank = on outside production. In production it MUST be
# set: `false` until the old hosted scheduler has stopped firing, then `true`
# (ADR-0008 §7 "Dağıtım sırası"); the worker refuses to start without it.
# JOBS_DATABASE_URL: connection for the worker's own `graphile_worker` schema
# (it creates/migrates it on start); blank = DATABASE_URL.
# JOBS_CONCURRENCY: jobs one worker runs at once; blank = 2.
JOBS_CRON_ENABLED=
# JOBS_DATABASE_URL=
JOBS_CONCURRENCY=
REDIS_URL=redis://localhost:6379

# --- Python worker ---
WORKER_URL=http://localhost:8000
WORKER_TOKEN=change-me

# --- AI ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536
# k1-embeddings job: USD ceiling per run (default 0.05). Raise on the worker for a one-off backfill.
K1_EMBEDDING_MAX_USD_PER_RUN=0.05

# --- External data ---
SEDIA_SEARCH_URL=https://api.tech.ec.europa.eu/search-api/prod/rest/search
SEDIA_API_KEY=SEDIA
SEDIA_TOPIC_DETAILS_URL=https://ec.europa.eu/info/funding-tenders/opportunities/data/topicDetails
CORDIS_HE_ZIP_URL=https://cordis.europa.eu/data/cordis-HORIZONprojects-csv.zip
CORDIS_H2020_ZIP_URL=https://cordis.europa.eu/data/cordis-h2020projects-csv.zip
# Call-list page overrides for the K1 adapters (src/lib/adapters/eurostars.ts,
# tubitak.ts). Commented out, not blank: read with `??`, a blank value becomes the URL.
# K1_EUROSTARS_URL=https://eurekanetwork.org/programmes/eurostars/
# K1_TUBITAK_URL=https://www.tubitak.gov.tr/tr/destekler
APIFY_TOKEN=
KEEP_EU_API_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# iyzico (TRY billing). Leave blank to keep the flow disabled — the webhook
# route then rejects every delivery instead of accepting unverifiable ones.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox by default; set to https://api.iyzipay.com only for live billing.
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Early-bird discount tier code from DISCOUNT_TIERS (src/lib/billing/catalog.ts),
# or NONE. Blank = list price, no campaign discount (src/lib/billing/active-tier.ts).
BILLING_ACTIVE_TIER=

# --- Storage / email / observability ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fabrika
# Blog images (POST /api/admin/blog/image): a SEPARATE bucket anyone may read
# (R2_BUCKET above stays private) and its public base URL, which may carry a
# path — MinIO http://localhost:9000/<bucket>, Supabase Storage
# https://<ref>.supabase.co/storage/v1/object/public/<bucket>. Both blank = the
# upload answers 503 object_store_unconfigured. next.config reads
# R2_PUBLIC_HOST at build time (images.remotePatterns), the CSP at run time.
R2_PUBLIC_BUCKET=
R2_PUBLIC_HOST=
# Another S3-compatible store instead of R2 (MinIO, Supabase Storage
# https://<ref>.storage.supabase.co/storage/v1/s3). R2_REGION blank = 'auto'
# (R2); Supabase signs with the project's region, e.g. eu-west-1.
R2_ENDPOINT=
R2_REGION=
# Outgoing mail over our own SMTP server (src/lib/email/mailer.ts). SMTP_HOST blank =
# no mail is sent (in production each attempt writes a SystemAlert). Local: the compose
# mailpit catches everything — SMTP_HOST=localhost, SMTP_PORT=1025, UI on :8025.
# SMTP_SECURE blank = implicit TLS on 465, STARTTLS otherwise; with SMTP_USER/SMTP_PASS
# set, a server without TLS is refused rather than sent the password in the clear.
# PRODUCTION: do not use a relay without SMTP_USER/SMTP_PASS (e.g. an IP-allowlisted
# relay). Without credentials STARTTLS is only opportunistic: if the relay does not
# offer it, the mail — including the invitation link, whose token is a login
# credential — travels in plain text. If such a relay cannot be avoided, set
# SMTP_SECURE=true (port 465) or make STARTTLS mandatory on the relay itself.
# Invitation mails also need NEXT_PUBLIC_APP_URL (above): unset, or a localhost URL in
# production, means no invitation mail is sent and a SystemAlert is written.
# Production (owner's decision 29.09.2026): our own SMTP server mail.fonbridge.com
# (Vulut), sender info@fonbridge.com. SPF/DKIM/DMARC for fonbridge.com and a TLS
# certificate for mail.fonbridge.com must be live first: docs/SMTP-SUNUCU.md.
#   SMTP_HOST=mail.fonbridge.com
#   SMTP_USER=info@fonbridge.com
#   SMTP_PASS=<mailbox password: the server's .env or secret store only>
# SMTP_HOST stays blank here: this file is copied to a local .env (README), and a
# local run must not reach the real server. Blank = no mail sent; mailpit: README.
SMTP_HOST=
# 465 = implicit TLS from the first byte (RFC 8314); SMTP_SECURE blank means TLS
# on exactly this port. 587 also works (STARTTLS, which the mailer enforces when
# SMTP_USER/SMTP_PASS are set), but then a stripped STARTTLS fails the send.
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FonBridge <info@fonbridge.com>"
# Sender for invitations and system mail. Commented out, not blank: src/lib/env.ts
# defaults it to info@fonbridge.com only when UNSET; a blank line sends from "".
# Only used when SMTP_FROM is unset.
# NEXT_PUBLIC_SMTP_FROM_ADDRESS=info@fonbridge.com
# Key for the hashed client IP of the public expert pre-registration (TASK-MVBIXPP33UK1B).
# Unset = a key derived from AUTH_SECRET is used (FO-23), so the per-IP limit stays on. Only when both are
# unset is the limit off. 32+ random characters; never reuse AUTH_SECRET.
# EXPERT_PREREG_IP_SALT=
# Weekly beta feedback digest recipient. Unset = the digest is computed but not sent.
# Leave the line commented out rather than blank: src/lib/env.ts validates it as an
# e-mail, and a blank value fails every import of env (seed, dev server).
# FEEDBACK_DIGEST_TO=ops@example.com
# Product analytics (src/lib/analytics.ts). Blank key = no-op, nothing is sent.
# Even with a key, events go out only after the visitor accepts analytics cookies,
# and carry no personal data. Host blank = https://eu.i.posthog.com (EU region).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Consecutive failed runs of the daily orphan-alert sweep before a SystemAlert
# (src/lib/jobs/tasks/alerts-sweep.ts). Positive integer; blank = 3.
ALERTS_SWEEP_FAILURE_THRESHOLD=

# --- Beta programme (src/lib/beta/constants.ts) ---
# Commented out, not blank: each is read with `??`, so a blank value replaces the
# built-in default with an empty address/link in the beta invite e-mail.
# BETA_SUPPORT_EMAIL=info@fonbridge.com
# BETA_FEEDBACK_EMAIL=info@fonbridge.com
# BETA_MEETING_URL=https://meet.google.com/eio-ftwm-wak

# --- Calendar Integration ---
# 256-bit AES-GCM key for CalendarConnection token encryption. Generate: openssl rand -base64 32
# Changing it makes existing encrypted tokens unreadable (users reconnect their calendar).
# Commented out, not blank: src/lib/calendar/encryption.ts reads
# `env.CALENDAR_ENCRYPTION_KEY ?? process.env.CALENDAR_ENCRYPTION_KEY`, and a blank
# value is not nullish, so it hides a key set later (tests/calendar-token-db.live.test.ts).
# CALENDAR_ENCRYPTION_KEY=

# --- TCMB exchange rates (ADR-0002) ---
# A foreign-currency invoice must state the TCMB forex buying rate of its issue
# date and the TL equivalent (VUK 215/280/385). The bulletin is public and needs
# no credential, so leave this blank in every real environment; it exists only so
# a test can point at a fixture host. There is no fallback rate: if TCMB cannot
# be read, no invoice is issued and a SystemAlert is raised.
TCMB_BASE_URL=

# --- e-Fatura: satıcı kimliği (INVOICE_SUPPLIER_*) ---
# Faturanın "kimden" bilgisi. Beşi (NAME, VKN, TAX_OFFICE, ADDRESS, CITY) eksikse
# fatura satırı yazılır ama BELGE üretilmez: /api/billing/invoices/<no>/export
# 503 supplier_identity_not_configured döner (eksik değişkenlerin adıyla).
# DİKKAT: buradaki ad TÜZEL KİŞİ UNVANIDIR (Fonbridge Eğitim, Proje ve Danışmanlık Ltd. Şti.), ürün adı değil
# (ürün: Fabrika). Emekli ürün adını temizleyen bir tarama bu değeri DEĞİŞTİRMEZ.
INVOICE_SUPPLIER_NAME=
INVOICE_SUPPLIER_VKN=
INVOICE_SUPPLIER_TAX_OFFICE=
INVOICE_SUPPLIER_ADDRESS=
INVOICE_SUPPLIER_CITY=
INVOICE_SUPPLIER_COUNTRY=
INVOICE_SUPPLIER_EMAIL=

# --- e-Fatura: KDV ---
# KDV için AYARLANACAK BİR DEĞİŞKEN YOKTUR. Oran 2026-09-08'den beri ALICININ
# ÜLKESİNDEN gelir (src/lib/billing/vat-rates.ts — ülke + oran + kaynak +
# yürürlük tarihi). Patron kararı 2026-09-08: fiyatlar KDV HARİÇ ilan edilir;
# Türkiye %20, Kuveyt %0. Kaynaklı satırı olmayan ülkeye fatura KESİLMEZ
# (SystemAlert üretilir) — tahmin yok. Oran değişecekse tabloya kaynaklı bir
# satır eklenir. (INVOICE_VAT_RATE 2026-09-09'da kaldırıldı — TASK-MTTTMECDO7RC8.)

# --- e-Fatura: özel entegratör (EFATURA_INTEGRATOR_*) ---
# Belgeyi GİB'e ileten lisanslı aracı. Dördü (PROVIDER, BASE_URL, USERNAME,
# PASSWORD) dolmadan gönderim denenmez. UYARI: bunlar dolu olsa BİLE gönderim
# çalışmaz — ADAPTERS (src/lib/efatura-integrator.ts) bugün yalnız `sandbox`
# içeriyor; seçilen satıcıya özel adaptör yazılana kadar sonuç
# `provider_unsupported` döner ve asla "gönderildi" denmez.
# PASSWORD repoya YAZILMAZ, sır yöneticisine girilir.
EFATURA_INTEGRATOR_PROVIDER=
EFATURA_INTEGRATOR_BASE_URL=
EFATURA_INTEGRATOR_USERNAME=
EFATURA_INTEGRATOR_PASSWORD=
EFATURA_INTEGRATOR_TEST_MODE=true
