# Canlı ortam değişkenleri ŞABLONU — yalnız adlar, değer yok.
# Kullanım: sunucuda `cp deploy/vps/.env.prod.example deploy/vps/.env.prod`, sonra
# değerleri sunucuda elle doldur (chmod 600). .env.prod git'e GİRMEZ (.gitignore: .env*).
# Değerleri repoya, sohbete, log'a yazma. Ad listesi: src/lib/env.ts + docs/RELEASE_CHECKLIST.md §2.
# Pilotta BOŞ kalmalı (ADR-0007): STRIPE_*, IYZICO_*, BILLING_ACTIVE_TIER, EFATURA_INTEGRATOR_*, INVOICE_SUPPLIER_*.
# Bu dosyada olmayan (kullanılmayan) ad: REDIS_URL, UPSTASH_*, GOOGLE_CLIENT_* (eski adlar).

# --- Uygulama (zorunlu) ---
NODE_ENV=
# Canlıda: https://nexagrant.com (kanonik). Yanlışsa davet ve e-posta bağlantıları bozulur.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_VERSION=
DEFAULT_LOCALE=
# Yalnız web ve worker içinde kullanılır; sunucu başlamadan AUTH_SECRET >= 32 karakter olmalı.
AUTH_SECRET=
NEXTAUTH_SECRET=
# Google OAuth (yeni fonbridges GCP istemcisi). Yönlendirme URI'si: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Caddy'nin tek ters vekil olduğu topoloji için 1. Boş bırakma.
TRUSTED_PROXY_HOPS=
# Üretimde yalnız boş ya da false. true ise sunucu başlamaz.
DEMO_LOGIN_ENABLED=

# --- Veritabanı ---
# Postgres container'ı tek kullanıcı: fabrika (süper kullanıcı, yalnız migration ve yedek için).
POSTGRES_PASSWORD=
# Uygulama rolü: fabrika_app (BYPASSRLS YOK). Sunucu adı: compose servis adı `postgres`.
# Biçim: postgresql://fabrika_app:<şifre>@postgres:5432/fabrika?schema=public
DATABASE_URL=
# Yalnız RLS ölçümü için (scripts/setup-rls-role.ts, scripts/check-rls-live.ts). Boşsa rol kurulumu sürmez.
DATABASE_URL_RLS_TEST=
# Worker'ın graphile_worker şeması. Boşsa DATABASE_URL. Rol şema oluşturma yetkisi ister (ADR-0008 §6.6).
JOBS_DATABASE_URL=
# Worker'da zorunlu açık seçim. İlk kurulum: false → migrasyon sonra true (RELEASE_CHECKLIST §3.3).
JOBS_CRON_ENABLED=
JOBS_CONCURRENCY=

# --- Proxy / kanıt / sır ---
EXPERT_PREREG_IP_SALT=
CALENDAR_ENCRYPTION_KEY=

# --- E-posta (kendi SMTP sunucusu; boşsa posta gitmez ve üretimde SystemAlert yazılır) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NEXT_PUBLIC_SMTP_FROM_ADDRESS=
FEEDBACK_DIGEST_TO=

# --- Dosya deposu (Cloudflare R2; boşsa yüklemeler object_store_unconfigured ile reddedilir) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_HOST=
R2_REGION=
R2_ENDPOINT=

# --- YZ sağlayıcıları (patron: OPENAI anahtarını önce yenile, RELEASE_CHECKLIST §8 madde 7) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KEEP_EU_API_KEY=

# --- Opsiyonel ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_CORDIS_WIDGET_KEY=
ALERTS_SWEEP_FAILURE_THRESHOLD=
CONSORTIUM_LIVE_DEMAND_WEIGHT=
BETA_SUPPORT_EMAIL=
BETA_FEEDBACK_EMAIL=
TCMB_BASE_URL=
