  budgetCents   BigInt?
  personMonths  Float?
  // NG-364 (K-586296 = B): where the seated member stands, and its letter of intent (spec §12 G1).
  // Moved only through src/modules/m8/server/member-stage.ts; null = no stage recorded. `status`
  // stays the seat's lifecycle: stage CONFIRMED only on a CONFIRMED seat. Cleared when an invite
  // puts another organisation on the seat, so a former member's letter never counts.
  memberStage    MemberStage?
  memberStageAt  DateTime?
  loiReceivedAt  DateTime?
  loiDocumentUrl String?
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
