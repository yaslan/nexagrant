// ───────────────────────── M4 Focal Point ─────────────────────────

/// `ownerUserId` is a work assignment, not a record: it names the internal
/// focal point who currently owns this relationship. No integrity rule depends
/// on it and the external party is held separately in `counterpartName` /
/// `counterpartEmail`, so there is no legal basis to keep it once that person
/// is erased. It is therefore nullable and the erasure purge detaches it
/// (`users-scheduled-deletion`); NULL means "unassigned — needs a new focal
/// point", which is also the state a relationship lands in after an erasure.
/// Decided 2026-09-08, A4 option C: the sibling case `DualApprovalStep.actorUserId`
/// went the other way and is retained, because there an approval is a signature.
model Relationship {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String?  // CORDIS PIC
  partnerOrgId   String?
  kind           String   // partner | ncp | city | cluster | consultant | tto
  ownerUserId    String?  // internal focal point; NULL = unassigned (or erased)
  counterpartName String?
  counterpartEmail String?
  warmth         String   @default("cold") // cold | warm | hot | active
  lastContactAt  DateTime?
  nextStep       String?
  nextStepDue    DateTime?
  notes          String?
  /// When the `m4-stale-relationships` job last put this relationship in its owner's
  /// "no contact for 60 days" digest. relationship-stale-reminded-at.sql
  staleRemindedAt DateTime?
  /// The `lastContactAt` that digest was about. A reminder is due again once
  /// `lastContactAt` differs from it (any new or re-dated contact, earlier or
  /// later) and has gone stale in turn. m4-stale-reminder-idempotency.sql
  staleRemindedContactAt DateTime?
  updatedAt      DateTime @updatedAt
  @@index([tenantId, ownerUserId])
  @@index([tenantId, lastContactAt])
}

model Interaction {
  id             String   @id @default(cuid())
  tenantId       String
  relationshipId String
  kind           String   // meeting | email | call | event
  at             DateTime
  summary        String?
  briefId        String?   // M9
  createdBy      String
  @@index([tenantId, relationshipId])
}

// ───────────────────────── M8 Consortium Matching ─────────────────────────

model SeatCandidate {
  id             String @id @default(cuid())
  tenantId       String
  seatId         String
  organizationId String?
  partnerOrgId   String?
  score          Float
  breakdown      Json
  rank           Int
  computedAt     DateTime @default(now())
  @@index([tenantId, seatId, rank])
}

// ───────────────────────── K6 AI ─────────────────────────

model AiUsageLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  module      String
  purpose     String
  provider    String
  model       String
  promptHash  String
  inputTokens Int
  outputTokens Int
  credits     Int
  proposalId  String?
  section     String?
  /// NG-387: the credit reservation (`CreditLedger.refId` of its `usage:<module>` row) this call
  /// delivered. Written only on a complete answer; NULL for a cut-off or refused answer, for an
  /// unreserved call and for every row older than NG-387. The ai-reservation-orphans job reads it
  /// as the delivery marker. See prisma/migrations/ai-usage-log-ref-id.sql.
  refId       String?
  createdAt   DateTime @default(now())
  @@index([tenantId, createdAt])
  @@index([tenantId, proposalId])
  @@index([tenantId, refId])
  @@index([module, createdAt])
}

model Document {
  id        String   @id @default(cuid())
  tenantId  String?  // null = shared public (work programmes)
  kind      String   // work_programme | topic | cordis_summary | tenant_upload
  title     String
  sourceUrl String?
  fileUrl   String?
  createdAt DateTime @default(now())
  chunks    Chunk[]
}

model Chunk {
  id         String @id @default(cuid())
  documentId String
  tenantId   String?
  ordinal    Int
  text       String
  embedding  Unsupported("vector(1536)")?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@index([documentId])
}

// ───────────────────────── Audit ─────────────────────────

// `tenantId` is nullable on purpose: a KVKK/GDPR erasure request from a user
// who belongs to no tenant still has to leave a trail
// (src/actions/user/request-deletion.ts). So this table takes the
// `tenant_or_shared` policy, not `tenant_isolation` — under strict isolation
// `NULL = 'x'` is not true and that row could be neither written nor read
// (TASK-MTU6HUB8FUHMG C-2).
model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  actorId   String?
  type      String   // module.state.changed | gate.decided | subscription.updated | ...
  target    String?
  data      Json?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
}

// The idempotency key of a payment-provider webhook delivery (ADR-0003).
//
// This used to be an `AuditEvent` row, found by `data->>'stripeEventId'`. That
// worked only because the app connects as a BYPASSRLS role: `AuditEvent` carries
// the `tenant_or_shared` policy, so under `fabrika_app` the key could neither be
// written nor read outside a tenant transaction — and it was written last, after
// the money. A webhook therefore granted credits, failed to record the key, and
// Stripe's redelivery re-ran the whole handler (TASK-MTVSBEO7VX6Y4, measured).
//
// Three things changed here, and each one is the reason a column exists:
//   • `tenantId` is NOT NULL, so this table takes the plain `tenant_isolation`
//     policy and lives inside `withTenant` with the money it guards.
//   • `stripeEventId` is UNIQUE, so a *second* concurrent delivery of the same
//     event is refused by Postgres rather than by a read-then-write guard that
//     both deliveries pass. That race was the open gap the old guard's own
//     docstring admitted to.
//   • the lock is no longer the audit trail. `AuditEvent` rows are still written
//     for every event; deleting one no longer unlocks a replay.
//
// `handler` names which webhook wrote it, so a replay can be attributed without
// joining back to the audit trail.
model StripeEventLog {
  id            String   @id @default(cuid())
  tenantId      String
  stripeEventId String   @unique
  handler       String   // subscription.sync | subscription.cancel | invoice.payment
  processedAt   DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, processedAt])
}

// ADR-0011 (TASK-MUVR24EHWI2RA). One row per recipient: `readAt` is that
// user's read state, so there is no per-workspace or browser-side copy of it
// (K-1 a, K-2 a). Tenant isolation is RLS (`tenant_isolation`, prisma/rls.sql);
// user isolation is the `userId` filter every read and write in
// src/lib/notifications/store.ts carries (K-5 a). `payload` holds ids and
// counts only; the text is rendered from `type` + `payload` with next-intl.
// Deleted after NOTIFICATION_RETENTION_DAYS (90, K-3 a) by
// `notifications-retention`, with the user (users-scheduled-deletion) and with
// the tenant (cascade). Migration: add-notification.sql.
model Notification {
  id          String           @id @default(cuid())
  tenantId    String
  userId      String           // recipient; User.id, no FK (SavedSearch.userId pattern)
  workspaceId String?          // NULL = tenant-wide (both MVP producers)
  type        NotificationType
  payload     Json             @default("{}")
  dedupeKey   String?          // same event twice -> one row (@@unique below)
  createdAt   DateTime         @default(now())
  readAt      DateTime?        // NULL = unread
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, dedupeKey])
  @@index([tenantId, userId, readAt, createdAt])
  @@index([createdAt])
}

enum NotificationType {
  SAVED_SEARCH_MATCH   // payload: { searchId, searchName, matchCount, since }
  CREDIT_GRANTED       // payload: { amount, period?, source } (no producer yet)
  CREDIT_EXHAUSTED     // payload: { module } (no producer yet)
  EVIDENCE_EXPIRING    // payload: { evidenceId, validUntil } (evidence-expiring job)
}

// NG-43 — spec §13 notification centre: per-user channel and frequency choice.
// One row per (user, §13 event, channel); no row = the default in
// src/lib/notifications/preferences.ts (panel INSTANT, e-mail OFF). The event list is the
// spec's, not NotificationType: src/lib/notifications/events.ts maps the stored types onto it.
// userId carries no FK, like Notification.userId; users-scheduled-deletion deletes by userId.
model NotificationPreference {
  id        String                @id @default(cuid())
  tenantId  String
  userId    String
  event     NotificationEvent
  channel   NotificationChannel
  frequency NotificationFrequency
  updatedAt DateTime              @updatedAt
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, event, channel])
}

// NG-43 — e-mail outbox of the notification centre. A dispatched notification whose e-mail
// preference is INSTANT or WEEKLY lands here; sendNotificationEmails sends INSTANT rows one by
// one and WEEKLY rows as one digest per user, then deletes what it sent. Text is never stored:
// type + payload, rendered at send time like the panel (ADR-0011 §3.1).
model NotificationEmailItem {
  id        String                @id @default(cuid())
  tenantId  String
  userId    String
  type      NotificationType
  payload   Json                  @default("{}")
  frequency NotificationFrequency
  dedupeKey String?
  createdAt DateTime              @default(now())
  /// Set when the SMTP server accepted the mail. The row stays so its dedupeKey
  /// keeps refusing the same notification (NG-43 review B-1); notifications-retention
  /// deletes it NOTIFICATION_RETENTION_DAYS after sentAt. Null = still queued.
  sentAt    DateTime?
  /// NG-131: one send run's claim on this row (random token + moment). A second run that
  /// starts while the first is mid-SMTP skips claimed rows, so a recipient is mailed once.
  /// Released (null) when the send fails; a claim older than the lease is reclaimable.
  claimToken String?
  claimedAt  DateTime?
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, dedupeKey])
  @@index([frequency, sentAt, createdAt])
  @@index([sentAt])
  @@index([tenantId, userId])
}

/// Spec §13 "Olaylar", in the spec's order.
enum NotificationEvent {
  NEW_MATCHING_CALL // yeni uygun çağrı
  CALL_CHANGED // çağrı değişikliği
  OUTREACH_REPLY // outreach yanıtı
  CONTRIBUTION_OVERDUE // katkı gecikmesi
  APPROVAL_OVERDUE // onay süresi aşımı
  BUDGET_DEVIATION // bütçe sapması
  TASK_COLOR_CHANGED // görev rengi değişimi
  REPORT_DUE // rapor yaklaşması
  OBLIGATION_REMINDER // yükümlülük hatırlatması
}

enum NotificationChannel {
  PANEL
  EMAIL
}

/// WEEKLY is e-mail only (the §13 weekly summary); the panel is INSTANT or OFF.
enum NotificationFrequency {
  INSTANT
  WEEKLY
  OFF
}

// ───────────────────────── v1.1+ (M6, M9, M10, M11, M7) ─────────────────────────


// M6 Evaluator Lens.
// Two shapes share this table, distinguished by `readerType`:
//   HUMAN | AI    — single-reader lens on an Opportunity (v1.0, excellence/impact/implementation)
//   PANEL         — multi-reviewer panel on a Proposal (v1.1, reviewers + criteria + scores)
// The v1.1 columns are all nullable or defaulted, so existing v1.0 rows and callers are unaffected.
model Evaluation {
  id             String      @id @default(cuid())
  tenantId       String
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  proposalId     String?     // v1.1 — set for PANEL evaluations
  proposal       Proposal?   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId         String?     // owning evaluator / creator
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  readerType     String      @default("HUMAN") // "HUMAN" | "AI" | "PANEL"
  status         String      @default("draft") // draft | in-progress | completed
  avgScore       Float?      // weighted 1-5 panel average; null until reviewers submit
  excellence     Float       @default(0)
  impact         Float       @default(0)
  implementation Float       @default(0)
  weaknesses     Json?
  calibration    Float?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  reviewers      Reviewer[]
  criteria       Criterion[]
  @@index([tenantId, proposalId])
  @@index([tenantId, opportunityId])
}

// One assigned reviewer on a PANEL evaluation. A user may sit on an evaluation once.
model Reviewer {
  id           String     @id @default(cuid())
  tenantId     String
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String     @default("evaluator") // evaluator | coordinator
  status       String     @default("pending")   // pending | completed
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  scores       Score[]
  @@unique([evaluationId, userId])
  @@index([evaluationId, status])
  @@index([tenantId])
}

// A weighted scoring axis of a PANEL evaluation. Weights are 0..1 and should sum to 1 per evaluation.
model Criterion {
  id           String     @id @default(cuid())
  tenantId     String
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  name         String     // Innovation | Feasibility | Impact | Communication
  weight       Float      @default(0)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  scores       Score[]
  @@unique([evaluationId, name])
  @@index([tenantId, evaluationId])
}

// One reviewer's mark on one criterion. score is 1..5 (DB CHECK in the M6 migration).
// submittedAt stays null while the reviewer is still drafting.
model Score {
  id          String    @id @default(cuid())
  tenantId    String
  reviewerId  String
  reviewer    Reviewer  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  score       Int
  comment     String?   @db.Text
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  @@unique([reviewerId, criterionId])
  @@index([criterionId])
  @@index([tenantId])
}

model MeetingBrief {
  id                  String      @id @default(cuid())
  tenantId            String
  interactionId       String      @unique
  partnerName         String?
  content             String
  meetingScheduledAt  DateTime?   // UTC meeting time
  meetingScheduledTz  String      @default("Europe/Brussels")
  createdAt           DateTime    @default(now())
  // The opportunity the brief was prepared for (add-meeting-brief-opportunity.sql).
  // NULL = "not linked to an opportunity": every brief written before the column
  // existed. SetNull, not Cascade: a brief is the user's own text and outlives
  // a hard-deleted opportunity. The FK does not check tenants (constraint checks
  // bypass RLS), so generateMeetingBrief refuses an id outside the session tenant.
  opportunityId       String?
  opportunity         Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId], map: "MeetingBrief_tenantId") // add-m9-meeting-schedule/migration.sql
  @@index([tenantId, opportunityId])
}

model CalendarConnection {
  id                String    @id @default(cuid())
  tenantId          String
  userId            String
  provider          String    // 'google' | 'outlook' | 'ics'
  externalId        String?   // Google: calendar ID, Outlook: mailbox address
  accessToken       String?   // Plaintext. Column is unpopulated today — no OAuth writer exists yet
                               // (google/outlook `connectCalendar` refuses with CALENDAR_OAUTH_NOT_CONFIGURED,
                               // `/api/calendar/callback` does not exist). Must be encrypted before that
                               // OAuth flow ships — see docs/ROADMAP.md open decision #12, TASK-MTSHP3BMTAD3Y.
  refreshToken      String?   // Same as accessToken above.
  tokenExpiresAt    DateTime?
  isConnected       Boolean   @default(true)
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, userId, provider])
  @@index([tenantId])
  @@index([userId])
}

model FollowupDoc {
  id             String      @id @default(cuid())
  tenantId       String
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  kind           String      // NDA, LOI, COMMITMENT, ESR_DEBRIEF, AWARD_PACK
  version        Int         @default(1)
  contentUrl     String?
  signedAt       DateTime?
  createdAt      DateTime    @default(now())

  // M10 dual approval — the submission that opens the flow (TASK-MTSAIWF4ENUSL).
  // The two department sign-offs live in DualApprovalStep; the final signature is
  // `signedAt` above. `approvalSubmittedByName` is a snapshot of the display name
  // as the session carried it, so the record stays readable after a rename.
  approvalSubmittedAt     DateTime?
  approvalSubmittedById   String?
  approvalSubmittedByName String?

  approvalSteps  DualApprovalStep[]
}

/// One department sign-off in the M10 dual approval flow (FINANCE or LEGAL).
///
/// The two four-eyes rules are unique indexes, not app-level checks:
///   @@unique([followupDocId, department])  — a department signs a document once
///   @@unique([followupDocId, actorUserId]) — a person signs at most one department
/// `actorUserId` is deliberately not a foreign key: an approval is a signature, and
/// the record must outlive a change to the user row that made it.
model DualApprovalStep {
  id            String      @id @default(cuid())
  tenantId      String
  followupDocId String
  followupDoc   FollowupDoc @relation(fields: [followupDocId], references: [id], onDelete: Cascade)
  department    String      // FINANCE | LEGAL
  actorUserId   String
  actorName     String
  note          String?
  decidedAt     DateTime    @default(now())

  @@unique([followupDocId, department])
  @@unique([followupDocId, actorUserId])
  @@index([tenantId, followupDocId])
}

model ApplicationPart {
  id             String      @id @default(cuid())
  tenantId       String
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  part           String      // PART_A, PART_B
  content        Json?       // Section tree, budget tables, etc.
  // SHA-256 (hex) of the partner portal token; the raw token is shown once and
  // never stored (src/lib/secret-token.ts, TASK-MULQLL2T8ZJX4).
  magicTokenHash String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model TtoPortfolioItem {
  id           String   @id @default(cuid())
  tenantId     String
  title        String
  trl          Int      @default(5)
  patentStatus String   // pending | granted | licensed
  summary      String
  keywords     String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([tenantId])
}

model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  keyHash     String    @unique
  prefix      String
  lastUsedAt  DateTime?
  /// Per-key rate limit window (src/lib/api-auth.ts): when the current one-minute window began.
  rateWindowStartedAt DateTime?
  /// Requests counted in the window that began at rateWindowStartedAt.
  rateWindowCount     Int       @default(0)
  createdAt   DateTime  @default(now())
  @@index([tenantId])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  tenantId  String
  role      Role     @default(MEMBER)
  // SHA-256 (hex) of the invite link token; the raw token is shown once and
  // never stored (src/lib/secret-token.ts, TASK-MULQLL2T8ZJX4).
  tokenHash String   @unique
  expires   DateTime
  // Set when the link is accepted (single use, TASK-MUN2793A57Z9I); NULL while
  // pending. A re-invite of the same address clears it with the new token.
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([email, tenantId])
}

model ApprovalRequest {
  id              String         @id @default(cuid())
  tenantId        String
  workspaceId     String?
  actionType      String         // GATE_G4_SUBMISSION | BUDGET_ALLOCATION | LEGAL_COMMITMENT | MEMBER_ROLE_ELEVATION | SENSITIVE_SETTINGS_CHANGE
  title           String
  description     String?
  payload         Json
  status          ApprovalStatus @default(PENDING)
  requiredRole    Role           @default(TENANT_ADMIN)
  requesterId     String
  approverId      String?
  rejectionReason String?
  auditHash       String?
  expiresAt       DateTime
  executedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester       User           @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  approver        User?          @relation("Approver", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([requesterId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}


// ───────────────────────── E11 Beta · feedback & triage ─────────────────────────

/// In-product feedback from beta design partners. Written first and always: the
/// SystemAlert write is best-effort, so a failure on the observability side must
/// never lose a partner's report. `autoPriority` keeps what the rule engine
/// decided even after a human overrides `priority` — that gap is how the rules
/// get calibrated during the beta.
model Feedback {
  id            String            @id @default(cuid())
  tenantId      String
  userId        String?
  workspaceSlug String?
  category      FeedbackCategory
  impact        FeedbackImpact    @default(MINOR)
  priority      FeedbackPriority  @default(P3)
  autoPriority  FeedbackPriority  @default(P3)
  status        FeedbackStatus    @default(NEW)
  title         String
  body          String
  triageReason  String?           // which rule fired, for auditability
  pageUrl       String?
  userAgent     String?
  appVersion    String?
  locale        String            @default("tr")
  screenshotKey String?           // R2 object key; the URL is signed on demand
  alertId       String?           // SystemAlert.id raised for this report
  alertStatus   String?           // recorded | failed ('legacy' = predates the SystemAlert channel)
  triageNote    String?
  triagedById   String?
  triagedAt     DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status, priority])
  @@index([priority, status])
  @@index([createdAt])
}

enum FeedbackCategory {
  BUG
  FEATURE_REQUEST
  UX
  PERFORMANCE
  DATA_QUALITY
  OTHER
}

/// What the reporter says the report costs them. Combined with category and a
/// keyword scan in src/lib/feedback/triage.ts to produce P0–P3.
enum FeedbackImpact {
  BLOCKER   // cannot work at all
  MAJOR     // major function unusable, no workaround
  MINOR     // annoying, workaround exists
  IDEA      // nothing is broken
}

enum FeedbackPriority {
  P0
  P1
  P2
  P3
}

enum FeedbackStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

// ─────────────────────────────────────────────────────────────────────────────
// Consent / disclosure record — TASK-MTSWLANXSU0IG (A3)
//
// Until this table existed, nothing recorded WHICH legal text a person was
// shown, WHEN, or at WHICH VERSION. `grep -n "Consent" prisma/schema.prisma`
// returned nothing on 2026-09-10, so a KVKK md.10 / GDPR art.13 disclosure and
// a GDPR art.7(1) consent were equally unprovable: the obligation may well have
// been discharged, but the controller could not demonstrate it, and art.5(2)
// makes demonstrating it the obligation.
//
// SCOPE COMES FROM THE REGISTER, NOT FROM A GUESS.
// docs/legal/processing-register.md lists 18 processing activities with their
// legal bases. Exactly ONE of them rests on explicit consent — §11, the
// Google/Outlook calendar OAuth (KVKK md.5/1 / GDPR art.6(1)(a)) — and that
// one writes no data yet. Account creation (§1) rests on art.6(1)(b), the
// contract. So asking a registering user to "consent" to it would be a false
// statement about the basis we actually rely on, and would imply a right to
// withdraw that does not exist for contract-basis processing. `kind` is what
// keeps those three cases apart on the record instead of flattening them into
// one word.
//
// NO `ipAddress` / `userAgent` COLUMN, deliberately.
// The card offered them "if the retention period is compatible with the
// register". It is not. The retention that fits a proof-of-compliance record is
// the one §12 already argues for `DualApprovalStep` — KVKK md.5/2-e /
// GDPR art.17(3)(e), kept so a right can be exercised or defended, i.e. beyond
// the account's own life. A permanently retained network identifier is a new
// undefined-retention item of personal data, which is open gap #1 in the
// register's own §22. The proof does not need it: who, which document, which
// version, when — those four columns carry it.
// ─────────────────────────────────────────────────────────────────────────────

/// Which legal instrument a `Consent` row records. These are not
/// interchangeable: only EXPLICIT_CONSENT is a legal basis under art.6(1)(a)
/// and only it is withdrawable.
enum ConsentKind {
  /// KVKK md.10 / GDPR art.13 — the notice was presented and acknowledged.
  /// An information duty, NOT a legal basis, and nothing to withdraw.
  DISCLOSURE_ACK

  /// Acceptance of the terms of service. This is how the art.6(1)(b) contract
  /// is formed; it is not consent to processing either.
  TERMS_ACCEPTANCE

  /// KVKK md.5/1 / GDPR art.6(1)(a) — freely given, specific, informed,
  /// unambiguous. The only kind `withdrawnAt` is truly meaningful for.
  EXPLICIT_CONSENT
}

/// The processing activity a `Consent` row belongs to, keyed to the section
/// numbers in docs/legal/processing-register.md. Only activities that really
/// exist appear here — the register's own rule is that no imagined activity is
/// written down, and the same discipline applies to this enum.
enum ConsentPurpose {
  /// §1 — account creation and authentication.
  ACCOUNT_REGISTRATION

  /// §11 — Google/Outlook calendar OAuth. The one genuinely consent-based
  /// activity in the register. No row can exist for it yet: the OAuth writer
  /// flow is not built (`connectCalendar` refuses with
  /// CALENDAR_OAUTH_NOT_CONFIGURED). It is declared so that the flow, when it
  /// is built, has a place to record consent rather than inventing one.
  CALENDAR_OAUTH

  /// NG-138 (M18-F4) — a readiness-funnel visitor agreed to have their contact request
  /// passed to a consultancy / agency tenant. Subject is `Consent.userId =
  /// 'public-lead:<PublicLead.id>'` (no account exists), tenant is the receiving one.
  /// Migration: add-consent-purpose-lead-intake.sql.
  LEAD_INTAKE
}

model Consent {
  id       String @id @default(cuid())
  /// CLAUDE.md rule 1. The subject gives the disclosure to Fabrika, but the row
  /// is scoped to the tenant the account was provisioned into, so a tenant
  /// owner can audit their own members' records and no one else's.
  tenantId String

  /// Deliberately NOT a foreign key, and deliberately NOT nulled on erasure —
  /// the same call, on the same basis, that §12 makes for
  /// `DualApprovalStep.actorUserId`. Detaching the person from the record would
  /// destroy the only thing the record exists to prove.
  /// See src/lib/inngest/jobs/users-scheduled-deletion.ts.
  userId String

  kind    ConsentKind
  purpose ConsentPurpose

  /// Stable identity of the text (e.g. `privacy-notice`), and the version of it
  /// that was actually on screen. The TEXT ITSELF is not stored: it lives in
  /// messages/{tr,en}.json behind a `t()` key and is served from
  /// src/app/[locale]/privacy. Storing a version rather than a copy is the
  /// whole point — when the text changes, the version changes, and an old row
  /// then says exactly what it should say: this person agreed to something
  /// else. A stored copy could not say that; it would just look current.
  documentId      String
  documentVersion String

  /// Which language the person actually read.
  locale String @default("tr")

  grantedAt   DateTime  @default(now())
  /// Withdrawal is recorded, never deleted — an erased withdrawal is
  /// indistinguishable from a withdrawal that never happened.
  withdrawnAt DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, userId, purpose])
  @@index([tenantId, purpose, documentVersion])
  @@index([userId, grantedAt])
}

// ───────────────────────── M17 Interreg pre-assessment ─────────────────────────
//
// FO-186 (TASK-MVRIV9LCDHYKO). One analysis = one call guide + one project file,
// uploaded by a user and extracted to text on the server. The uploaded bytes are
// never stored: only the extracted text, and only until each slot's own `…TextExpiresAt`
// (30 days, owner decision in FO-185). Output is an *internal* pre-assessment,
// never an official score (CLAUDE.md "Yapma"). Migration: add-interreg-review.sql.
//
// The rubric is data, not code (FO-187): InterregRubric + InterregRubricCriterion
// are platform reference tables (no tenant, read-only for the app role — the
// platform_read block of prisma/rls.sql), written by prisma/seed-interreg-rubrics.ts
// from the programme's published assessment grid. Another programme or call is a
// new InterregRubric row, never a code change. A rubric row is referenced by
// analyses and marks, so its numbers are not edited in place: a revised grid is a
// new `id` (e.g. `…call3.regular`).

enum InterregAnalysisStatus {
  UPLOADING // created; neither document extracted yet (or only the project file)
  EXTRACTING // reserved for an asynchronous extractor; the F1 route extracts in-request
  CALL_READY // call guide extracted, project file missing
  READY // both extracted — the UI enables "check the project"
  ANALYZING // F2: the LLM run is in progress
  DONE // F2: InterregAnalysisResult written
  FAILED // F2: the LLM run failed; documents are kept
}

enum InterregDocFormat {
  PDF
  DOCX
  MD
  TXT
}

/// One assessment grid of one programme call and project type, e.g.
/// `interreg-next-bsb.call2.regular` (Annex 7 Quality Assessment Grid).
model InterregRubric {
  /// Stable, versioned key: `<programme>.<call>.<project type>`.
  id                String   @id
  /// Programme key, e.g. `interreg-next-bsb`; groups the profiles a user picks from.
  programme         String
  /// Display label; carries "internal pre-assessment — not an official score".
  label             String
  /// The profile used when a new analysis names none (at most one per programme, by convention).
  isDefault         Boolean  @default(false)
  /// Marks a criterion may take, e.g. [1, 1.5, 2, …, 4] (half points, no 0).
  allowedMarks      Json
  /// Sum of the criteria's `maxMark` (56 for 14 × 4); checked against them by the seed.
  maxRaw            Decimal  @db.Decimal(6, 1)
  /// Total below which the programme rejects (37 of 56); `null` = no total threshold.
  passRaw           Decimal? @db.Decimal(6, 1)
  /// Interreg funding range, minor units (cent) + currency (CLAUDE.md §9).
  budgetMinMinor    Int?
  budgetMaxMinor    Int?
  currency          String?
  maxDurationMonths Int?
  /// Where the grid comes from: documents, URL, what could not be verified.
  source            Json
  /// Ordered tie-break keys (`section:<key>` | `criterion:<key>`).
  tieBreak          Json     @default("[]")
  /// Programme rules outside the grid (indicators, partnership, budget, duration).
  programChecks     Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  criteria InterregRubricCriterion[]
  analyses InterregAnalysis[]

  @@index([programme])
}

model InterregRubricCriterion {
  id                  String   @id @default(cuid())
  rubricId            String
  /// Stable key within the rubric, e.g. `relevance_so_fit`.
  criterionKey        String
  /// The programme's own number, e.g. `1.1`.
  officialRef         String
  section             String
  /// `strategic` | `operational` (Annex 7 parts I/II).
  group               String
  name                String
  position            Int
  maxMark             Decimal  @db.Decimal(4, 1)
  /// A mark below this rejects the application whatever the total (1.1, 1.2, 5.1 < 3).
  knockoutBelow       Decimal? @db.Decimal(4, 1)
  subQuestions        Json     @default("[]")
  /// Application form sections the evidence is read from.
  afSections          Json     @default("[]")
  evidenceExpectation String?  @db.Text

  rubric InterregRubric          @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  marks  InterregCriterionMark[]

  /// Target of InterregCriterionMark's (criterionId, rubricId) FK.
  @@unique([id, rubricId])
  @@unique([rubricId, criterionKey])
  @@index([rubricId, position])
}

model InterregAnalysis {
  id       String                 @id @default(cuid())
  tenantId String
  userId   String
  /// The grid this analysis is assessed against, chosen at creation.
  rubricId String
  status   InterregAnalysisStatus @default(UPLOADING)

  callFileName    String?
  callFormat      InterregDocFormat?
  callPages       Int? // PDF only
  callChars       Int?
  callText        String?            @db.Text
  callExtractedAt DateTime?
  /// The call text is purged at this instant (30 days from THIS slot's upload, FO-195 B5).
  /// Set exactly when `callText` is (CHECK InterregAnalysis_text_expiry_pair).
  callTextExpiresAt DateTime?

  projectFileName    String?
  projectFormat      InterregDocFormat?
  projectPages       Int?
  projectChars       Int?
  projectText        String?            @db.Text
  projectExtractedAt DateTime?
  /// Same for the project text, counted from its own upload.
  projectTextExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rubric InterregRubric          @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  result InterregAnalysisResult?
  marks  InterregCriterionMark[]

  /// Targets of the composite FKs below (se-fb D1 / crw2 Ö5): a result or mark can
  /// only point at an analysis of its own tenant, and a mark only at that analysis's rubric.
  @@unique([id, tenantId])
  @@unique([id, tenantId, rubricId])
  @@index([tenantId, userId, createdAt])
  /// Partial indexes (WHERE … IS NOT NULL) are in add-interreg-slot-retention.sql; Prisma cannot express them.
  @@index([rubricId])
}

/// The F2 LLM output for one analysis: at most one row, replaced on re-run.
/// Scores are on the rubric's own scale (`rawScore` of `maxRaw`) plus the
/// proportional 0..100 view (FO-187 §5.1) — an internal estimate, never official.
model InterregAnalysisResult {
  id               String   @id @default(cuid())
  tenantId         String
  analysisId       String   @unique
  rawScore         Decimal  @db.Decimal(6, 1)
  score100         Decimal  @db.Decimal(4, 1)
  /// `rawScore` ≥ rubric `passRaw` and no knockout criterion below its floor.
  passesThresholds Boolean
  /// criterionKeys whose mark fell below `knockoutBelow`.
  knockouts        Json     @default("[]")
  reportMarkdown   String   @db.Text
  redFlags         Json     @default("[]")
  improvements     Json     @default("[]")
  rewriteSample    Json     @default("{}")
  /// Programme rules outside the grid: [{ key, status: met|missing|unclear, note }] (FO-188).
  programChecks    Json     @default("[]")
  model            String
  promptHash       String
  createdAt        DateTime @default(now())

  /// (analysisId, tenantId): the database refuses a result filed under another tenant's analysis.
  analysis InterregAnalysis @relation(fields: [analysisId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([analysisId, tenantId])
  @@index([tenantId])
}

/// One rubric criterion's mark for an analysis (F2), on the rubric's scale
/// (one of `allowedMarks`), with the strengths and weaknesses behind it.
model InterregCriterionMark {
  id              String   @id @default(cuid())
  tenantId        String
  analysisId      String
  /// Copy of the analysis's rubricId, so the two FKs below can tie the criterion to it.
  rubricId        String
  criterionId     String
  mark            Decimal  @db.Decimal(4, 1)
  strengths       Json     @default("[]")
  weaknesses      Json     @default("[]")
  evidenceQuote   String?  @db.Text
  evidenceLocator String?
  /// Every [{ quote, location }] behind the mark; evidenceQuote/Locator keep the first (FO-188).
  evidence        Json     @default("[]")
  createdAt       DateTime @default(now())

  /// Same tenant and same rubric as the analysis; the criterion must belong to that rubric.
  analysis  InterregAnalysis        @relation(fields: [analysisId, tenantId, rubricId], references: [id, tenantId, rubricId], onDelete: Cascade)
  criterion InterregRubricCriterion @relation(fields: [criterionId, rubricId], references: [id, rubricId], onDelete: Restrict)

  @@unique([analysisId, criterionId])
  @@index([tenantId])
  @@index([criterionId])
}

// ───────────────────────── M18 Client Pipeline / Müşteri Satış Hattı (NG-143) ─────────────────────────
// A consultancy's sales pipeline over its own clients. Not the applicant's Opportunity (G0–G4),
// not Relationship (partners), not Proposal (the EU application): different nouns on purpose.
// Rewritten from the HibeLead Drizzle schema to FonBridge rules (FO-265 §3): cuid ids, tenantId +
// strict RLS (prisma/rls.sql, prisma/migrations/add-m18-client-pipeline.sql), money as Int cents
// + currency, soft delete via deletedAt. Tenant-level only, no workspaceId (lead assumption, K4).
// Every table carries sourceRef + @@unique([tenantId, sourceRef]) so a later import
// ("hibelead:<uuid>") can be re-run with ON CONFLICT DO NOTHING (FO-265 §5).
// Child → parent links are composite (parentId, tenantId) → (id, tenantId): a row cannot point at
// another tenant's parent (RLS checks only the row's own tenantId; FK checks bypass RLS).
// Optional composite links use NoAction (checked at statement end), never SetNull: SetNull would
// null tenantId too. Parents are soft-deleted, so the link survives in practice.

// HibeLead deal_stage, in pipeline order: 11 stages NEW → REJECTED, plus LOST as the exit a deal
// can take from any stage. WON / REJECTED are the grant outcome after SUBMITTED.
enum DealStage {
  NEW
  QUALIFIED
  CONTACTED
  DISCOVERY_MEETING
  ELIGIBILITY_ANALYSIS
  PROPOSAL
  CONTRACT
  APPLICATION_PREP
  SUBMITTED
  WON
  REJECTED
  LOST
}

model LeadOrganization {
  id               String        @id @default(cuid())
  tenantId         String
  name             String
  legalName        String?
  orgType          String? // HibeLead 18-value taxonomy as text; mapped to OrgType in F2
  provinceCode     String? // TR plate code, e.g. "06"
  district         String?
  nuts2            String?
  website          String?
  sectorCodes      String[]      @default([])
  themes           String[]      @default([])
  sizeBand         String? // MICRO | SMALL | MEDIUM | LARGE
  lifecycle        String        @default("LEAD") // LEAD | CLIENT | DISQUALIFIED
  disqualifyReason String?
  ownerUserId      String? // no FK: a removed user keeps the history (Deal.ownerUserId too)
  pic              String? // EU Participant Identification Code, if known
  cordisPic        String? // optional link to CordisOrganization.organisationId (M1), no FK
  partnerOrgId     String? // optional link to PartnerOrg (M1 pool), no FK (different module)
  dedupeKey        String? // normalised name/tax key for duplicate detection (F2)
  sourceRef        String?
  deletedAt        DateTime?
  deletionReason   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts         LeadContact[]
  matches          LeadMatch[]
  deals            Deal[]
  eligibilityReports LeadEligibilityReport[]

  @@unique([id, tenantId])
  @@unique([tenantId, sourceRef])
  @@index([tenantId, name])
  @@index([tenantId, dedupeKey])
  @@index([deletedAt])
}

model LeadContact {
  id              String           @id @default(cuid())
  tenantId        String
  organizationId  String
  fullName        String
  title           String?
  email           String?
  phone           String?
  linkedinUrl     String?
  doNotContact    Boolean          @default(false) // consent itself lives in Consent, not here (FO-265 §2)
  sourceRef       String?
  deletedAt       DateTime?
  deletionReason  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization    LeadOrganization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  primaryForDeals Deal[]

  @@unique([id, tenantId])
  @@unique([tenantId, sourceRef])
  @@index([tenantId, organizationId])
  @@index([deletedAt])
}

// A client organisation × a (shared) call. Not TopicMatch: that one matches the tenant itself.
model LeadMatch {
  id             String           @id @default(cuid())
  tenantId       String
  organizationId String
  callId         String
  fitScore       Int? // 0–100 soft score
  hardFail       Boolean          @default(false) // an eligibility rule fails outright
  reasons        Json             @default("[]")
  status         String           @default("SUGGESTED") // SUGGESTED | ACCEPTED | REJECTED | CONTACTED
  sourceRef      String?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   LeadOrganization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  call           Call             @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([tenantId, organizationId, callId])
  @@unique([tenantId, sourceRef])
  @@index([callId])
  @@index([deletedAt])
}

model Deal {
  id                String           @id @default(cuid())
  tenantId          String
  organizationId    String
  primaryContactId  String?
  callId            String?
  servicePackageId  String?
  title             String
  stage             DealStage        @default(NEW)
  stageChangedAt    DateTime         @default(now())
  leadScore         Int? // 0–100 (Fit/Need/Intent/Timing, F2)
  scoreBreakdown    Json?
  estimatedFeeCents Int? // minor units, src/lib/money.ts
  currency          String           @default("EUR")
  winProbability    Int? // 0–100
  expectedCloseAt   DateTime?
  lostReason        String?
  ownerUserId       String?
  sourceRef         String?
  deletedAt         DateTime?
  deletionReason    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization      LeadOrganization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  primaryContact    LeadContact?     @relation(fields: [primaryContactId, tenantId], references: [id, tenantId], onDelete: NoAction)
  servicePackage    ServicePackage?  @relation(fields: [servicePackageId, tenantId], references: [id, tenantId], onDelete: NoAction)
  call              Call?            @relation(fields: [callId], references: [id], onDelete: SetNull)
  activities        DealActivity[]
  tasks             DealTask[]
  quotes            ServiceQuote[]

  @@unique([id, tenantId])
  @@unique([tenantId, sourceRef])
  @@index([tenantId, stage])
  @@index([tenantId, organizationId])
  @@index([callId])
  @@index([deletedAt])
}

model DealActivity {
  id          String    @id @default(cuid())
  tenantId    String
  dealId      String
  kind        String // NOTE | CALL | MEETING | EMAIL_OUT | EMAIL_IN | FORM | STAGE_CHANGE | DOCUMENT …
  payload     Json      @default("{}")
  note        String?
  actorUserId String?
  occurredAt  DateTime  @default(now())
  sourceRef   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal        Deal      @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, sourceRef])
  @@index([tenantId, dealId, occurredAt])
  @@index([deletedAt])
}

model DealTask {
  id             String    @id @default(cuid())
  tenantId       String
  dealId         String
  title          String
  dueAt          DateTime?
  doneAt         DateTime?
  assigneeUserId String?
  autoGenerated  Boolean   @default(false) // created by a pipeline rule (F2)
  autoRuleKey    String?
  sourceRef      String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal           Deal      @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, sourceRef])
  @@index([tenantId, dealId])
  @@index([tenantId, dueAt])
  @@index([deletedAt])
}

// The consultancy's own fee. The success fee (başarı primi) is NOT an eligible cost in a grant
// budget (docs/BILLING.md); FunderRule carries that warning next to a quote.
model ServicePackage {
  id                 String         @id @default(cuid())
  tenantId           String
  name               String
  pricingModel       String         @default("FIXED") // FIXED | FIXED_PLUS_SUCCESS | HOURLY | RETAINER
  baseFeeCents       Int // minor units
  successFeeBp       Int? // basis points of the awarded grant: 500 = 5 %
  successFeeCapCents Int? // ceiling of the success fee, minor units
  currency           String         @default("EUR")
  deliverables       String[]       @default([])
  active             Boolean        @default(true)
  sourceRef          String?
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals              Deal[]
  quotes             ServiceQuote[]

  @@unique([id, tenantId])
  @@unique([tenantId, sourceRef])
  @@index([tenantId, active])
  @@index([deletedAt])
}

// Named ServiceQuote, not Proposal: `Proposal` is the EU application (M5).
model ServiceQuote {
  id         String          @id @default(cuid())
  tenantId   String
  dealId     String
  version    Int             @default(1)
  packageId  String?
  lineItems  Json            @default("[]") // [{label, quantity, unitCents}] — minor units
  totalCents Int // minor units
  currency   String          @default("EUR")
  status     String          @default("DRAFT") // DRAFT | SENT | VIEWED | ACCEPTED | REJECTED
  validUntil DateTime?
  sourceRef  String?
  deletedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal       Deal            @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Cascade)
  package    ServicePackage? @relation(fields: [packageId, tenantId], references: [id, tenantId], onDelete: NoAction)

  @@unique([tenantId, dealId, version])
  @@unique([tenantId, sourceRef])
  @@index([deletedAt])
}

// A funder-side rule the consultancy records and shows next to a quote or fee (e.g. "the success
// fee is not an eligible cost under this programme"). Informational; it blocks nothing by itself.
model FunderRule {
  id          String     @id @default(cuid())
  tenantId    String
  funderName  String
  programmeId String? // optional link to the shared Programme
  title       String
  body        String
  severity    String     @default("INFO") // INFO | WARNING | BLOCKER
  sourceUrl   String?
  verifiedAt  DateTime?
  active      Boolean    @default(true)
  sourceRef   String?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sourceRef])
  @@index([tenantId, funderName])
  @@index([programmeId])
  @@index([deletedAt])
}

// M18-F5 (NG-136): the AI eligibility pre-report of one client organisation against one shared
// call. An INTERNAL pre-assessment ("iç ön değerlendirme"), never an official score: no numeric
// score is stored. DRAFT until a user approves it; only an APPROVED report may leave the module
// (src/modules/m18/server/eligibility.ts `releasableReport`, the deal brief contract).
model LeadEligibilityReport {
  id               String           @id @default(cuid())
  tenantId         String
  organizationId   String
  callId           String
  status           String           @default("DRAFT") // DRAFT | APPROVED
  content          String // the model's Markdown, as generated; never edited in place
  locale           String           @default("tr") // prompt locale the report was written in
  model            String? // provider model id, from the AiUsageLog of the call
  createdByUserId  String? // no FK: a removed user keeps the history
  approvedByUserId String?
  approvedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization     LeadOrganization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  call             Call             @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, organizationId, createdAt])
  @@index([callId])
  @@index([deletedAt])
}
