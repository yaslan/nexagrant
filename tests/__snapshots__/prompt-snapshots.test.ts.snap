exports[`prompt text is byte-identical to the pre-move inline literals > M6 AI evaluation (prompt + system) 1`] = `
{
  "messages": undefined,
  "prompt": "Perform a rigorous EU Horizon Europe expert evaluation for opportunity cm0opportunity0000000001 based on official REA criteria:
  1. Excellence (0.0 - 5.0): Clarity of objectives, soundness of methodology, open science, gender dimension.
  2. Impact (0.0 - 5.0): Credibility of outcomes/impacts, scale and significance, dissemination & exploitation plan (DEC).
  3. Quality and efficiency of implementation (0.0 - 5.0): Work plan structure, WPs, milestone risk management, consortium capacity.

  Return ONLY valid JSON with keys: excellence (number), impact (number), implementation (number),
  strengths (string[]), weaknesses (string[]), recommendations (string[]).",
  "system": "You are an official European Commission Horizon Europe Proposal Evaluator. Return ONLY valid JSON.",
}
`;

exports[`prompt text is byte-identical to the pre-move inline literals > M6 ESR parser (prompt + system) 1`] = `
{
  "messages": undefined,
  "prompt": "Analyze the following EU Horizon Europe Evaluation Summary Report (ESR) text.
Extract the criteria marks and qualitative comments.

Return ONLY valid JSON with keys:
- excellence: number (0.0 to 5.0)
- impact: number (0.0 to 5.0)
- implementation: number (0.0 to 5.0)
- total: number (0.0 to 15.0)
- threshold: number (default 10.0)
- passed: boolean (true if total >= threshold and all subcriteria >= 3.0)
- strengths: string[]
- weaknesses: string[]

ESR Document Text:
"""
Excellence 4.5
Impact 4.0
Implementation 3.5
"""",
  "system": "You are an EU Horizon Europe ESR document parser. Return ONLY valid JSON.",
}
`;

