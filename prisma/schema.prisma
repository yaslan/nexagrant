// Fabrika — Prisma schema (MVP scope + v1.1 tables marked)
// Conventions: PascalCase singular models, camelCase fields, tenantId on every tenant-scoped table.
// Money: Int minor units + currency. Timestamps UTC.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ───────────────────────── Tenancy & identity ─────────────────────────

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  country       String   // ISO-3166-1 alpha-2
  orgType       OrgType  @default(SME)
  pic           String?  // EU Participant Identification Code
  locale        String   @default("tr")
  timezone      String   @default("Europe/Istanbul")
  settings      Json     @default("{}") // scoringWeights, gateRules, aiRegion...
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String?

  users         Membership[]
  workspaces    Workspace[]
  profile       TenantProfile?
  subscription  Subscription?
  moduleStates  ModuleState[]
  creditLedger  CreditLedger[]
  lifetimeLicences LifetimeLicence[]
  auditEvents   AuditEvent[]
  invitations   Invitation[]
  approvalRequests ApprovalRequest[]
  invoices      Invoice[]
  billingIdentity TenantBillingIdentity?
  planAssignments PlanAssignment[]
  @@index([deletedAt])
}

enum OrgType {
  SME
  LARGE
  UNIVERSITY
  RESEARCH
  PUBLIC
  NGO
  CONSULTANCY
  CLUSTER
  MUNICIPALITY
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified DateTime?
  image         String?
  name          String?
  locale        String   @default("tr")
  isPlatformAdmin Boolean @default(false)
  // KVKK md.7/md.11 · GDPR art.17 — erasure grace period. See prisma/migrations/add-soft-delete.sql
  deletionRequestedAt DateTime?  // set when the subject asks for erasure; purge job scans this
  deletedAt     DateTime?        // soft-delete marker: hidden from the product, still restorable
  deletionReason String?         // subject_request | policy | tenant_cascade
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  memberships   Membership[]
  accounts      Account[]
  sessions      Session[]
  evaluations   Evaluation[]
  reviewerSeats Reviewer[]
  requestedApprovals ApprovalRequest[] @relation("Requester")
  approvedApprovals  ApprovalRequest[] @relation("Approver")
  @@index([deletionRequestedAt])
  @@index([deletedAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(MEMBER)
  workspaceIds String[] // empty = all workspaces of tenant
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
}

enum Role {
  TENANT_OWNER
  TENANT_ADMIN
  PIPELINE_MANAGER
  WRITER
  MEMBER
  GUEST_PARTNER
}

model Workspace {
  id        String   @id @default(cuid())
  tenantId  String
  name      String   // e.g. client name for consultancies
  slug      String
  createdAt DateTime @default(now())
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  @@unique([tenantId, slug])
  @@index([deletedAt])
}

model TenantProfile {
  tenantId      String   @id
  capabilities  String   // free text, used for embedding
  keywords      String[]
  naceCodes     String[]
  trlRange      Int[]    // [min,max]
  preferredRoles String[] // coordinator, tech_provider, pilot_site, dissemination...
  priorProjects Json     @default("[]")
  embedding     Unsupported("vector(1536)")?
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Modules & entitlements ─────────────────────────

model ModuleCatalog {           // platform-level, seeded from manifests
  id          String  @id      // "M1".."M11"
  key         String  @unique
  name        String
  version     String
  requires    String[]
  recommends  String[]
  planTiers   String[]
  addOnSku    String?
  isActive    Boolean @default(true)
}

enum ModuleStatus {
  OFF
  DEV
  PILOT
  ON
}

model ModuleState {
  id        String       @id @default(cuid())
  tenantId  String
  moduleId  String
  status    ModuleStatus @default(OFF)
  settings  Json         @default("{}")
  changedBy String?
  changedAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, moduleId])
}

model Plan {                    // projection of src/lib/billing/catalog.ts; seeded: free, basic, pro, ultra
  id            String  @id    // "pro"
  name          String
  monthlyCents  Int            // list price, minor units — the campaign discount lives at checkout
  yearlyCents   Int
  currency      String  @default("USD")
  seats         Int
  workspaces    Int
  aiCreditsMonthly Int
  modules       String[]       // default ON modules
  stripePriceMonthly String?
  stripePriceYearly  String?
  visibility    String  @default("public") // public | private | archived
  versions      PlanVersion[]
  assignments   PlanAssignment[]
}

model PlanVersion {
  id            String  @id    @default(cuid())
  planId        String
  plan          Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  version       Int             // semantic version: 1, 2, 3, ...
  status        String  @default("draft") // draft | published | archived
  monthlyCents  Int
  yearlyCents   Int
  currency      String  @default("USD")
  seats         Int
  workspaces    Int
  aiCreditsMonthly Int
  modules       String[]       // modules granted by this version
  features      PlanFeature[]
  publishedBy   String?        // user id who published this version
  publishedAt   DateTime?      // when this version was published (immutable after)
  subscriptions Subscription[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([planId, version])
}

model PlanFeature {
  id            String  @id    @default(cuid())
  planVersionId String
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  order         Int             // display order (1, 2, 3, ...)
  kind          String          // module | limit | text
  moduleId      String?         // if kind='module': module identifier (M1, M8, etc)
  limitKey      String?         // if kind='limit': limit identifier (e.g. "seats", "credits")
  textTr        String?         // if kind='text': Turkish label or description
  textEn        String?         // if kind='text': English label or description
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([planVersionId, order])
}

model PlanAssignment {
  id            String  @id    @default(cuid())
  planId        String
  plan          Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedBy    String?        // user id who made the assignment
  assignedAt    DateTime @default(now())
  note          String?        // reason or memo
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([planId, tenantId])
}

model AddOnCatalog {
  sku           String @id     // "addon_m6", "addon_m11", "addon_seat_team", "addon_credits_250"
  name          String
  monthlyCents  Int?
  oneTimeCents  Int?
  currency      String @default("EUR")
  grantsModule  String?
  grantsSeats   Int?
  grantsCredits Int?
  grantsWorkspaces Int?
  stripePriceId String?
}

model Subscription {
  tenantId          String   @id
  planId            String
  status            SubStatus @default(TRIALING)
  billingInterval   String   @default("month") // month|year
  provider          String   @default("stripe") // stripe|iyzico
  providerCustomerId String?
  providerSubId     String?
  currentPeriodEnd  DateTime?
  seatsExtra        Int      @default(0)
  workspacesExtra   Int      @default(0)
  trialEndsAt       DateTime?
  // The joined price, kept (TASK-MTR882HVZ8BG7). The pricing page promises the
  // rate a tenant joins at stays theirs; nothing here recorded it, so every
  // quote came from the campaign running now. Written once on activation and on
  // a re-activation after cancellation, never in between — the rule and the
  // reasoning live in src/lib/billing/price-lock.ts. All five are nullable
  // together: a row with none of them is a subscription sold before the lock
  // existed and is priced at the shopfront tier, as it was.
  lockedTierCode    String?   // campaign the rate came from, e.g. ILK5 (provenance)
  lockedPercentOff  Int?      // the rate honoured on renewal, whole percent
  lockedAmountMinor Int?      // what one period cost at that rate, minor units (rule 9)
  lockedCurrency    String?   // currency of lockedAmountMinor
  priceLockedAt     DateTime? // when the rate was locked
  planVersionId     String?  // current plan version (ADIM 2: checkout writes this)
  planVersion       PlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addOns            AddOn[]
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

model AddOn {
  id             String   @id @default(cuid())
  tenantId       String
  sku            String
  quantity       Int      @default(1)
  providerItemId String?
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  subscription   Subscription @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  @@index([tenantId, sku])
}

model LifetimeLicence {          // one-time "first 20 companies" purchase; the pricing page counts these rows
  id                String   @id @default(cuid())
  tenantId          String
  seq               Int      @unique   // which licence of the limited run this is: 1, 2, 3…
  sku               String   @default("lifetime-ultra")
  amountMinor       Int                // what was actually charged, minor units
  currency          String   @default("USD")
  provider          String   @default("stripe")
  providerEventId   String   @unique   // idempotency: one webhook event writes at most one licence
  providerSessionId String?  @unique   // idempotency: one checkout session writes at most one licence
  purchasedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, purchasedAt])
}

model Invoice {                 // an invoice actually issued to a tenant; TASK-MTRD9QBJ2G32E
  id            String   @id @default(cuid())
  tenantId      String
  number        String              // what the customer sees and cites, e.g. "FB-2026-000001"
  issuedAt      DateTime            // UTC, like every other timestamp (CLAUDE.md rule 10)
  currency      String   @default("TRY")
  // VUK 215/280/385 (ADR-0002, option (b)): an invoice denominated in a foreign
  // currency is only valid while it also states the TCMB *buying* rate of its
  // issue date and the Turkish lira equivalent. Those two facts are stored on
  // the row and not merely computed into the XML, so an already-issued document
  // can be reproduced and audited later (CLAUDE.md rule 7).
  //
  // NULL on a TRY invoice: there is nothing to convert. On any other currency a
  // CHECK constraint (`Invoice_fx_required_for_foreign_currency`) refuses the
  // row outright — an invented rate would be an invented figure on a fiscal
  // document, so the invoice is not issued at all rather than issued wrong.
  fxRate             Decimal?  @db.Decimal(18, 6) // TCMB döviz alış kuru: 1 `currency` → TRY
  fxRateDate         DateTime? @db.Date           // publication date of the rate actually used; may precede `issuedAt` across a weekend or public holiday
  fxRateSource       String?                      // where the rate came from, e.g. "TCMB"; never a guess
  grandTotalTryMinor Int?                         // TL karşılığı of the payable grand total, minor units (CLAUDE.md rule 9)
  // The buyer's fiscal identity, frozen at issue time. An invoice must keep
  // saying who it was issued to even after the tenant renames itself or moves,
  // so these are a snapshot on the row and never a join to Tenant.
  buyerName      String
  buyerVknTckn   String             // 10-digit VKN or 11-digit TCKN, as supplied by the buyer
  buyerTaxOffice String
  buyerAddress   String
  buyerCity      String
  buyerCountry   String  @default("Türkiye")
  lines         Json                // InvoiceLine[]; unit prices are minor units (CLAUDE.md rule 9)
  profileId     String   @default("TICARIFATURA")  // TICARIFATURA | TEMELFATURA | EARSIVFATURA
  invoiceType   String   @default("SATIS")         // SATIS | ISTISNA | TEVKIFAT
  ettn          String   @unique    // the document's own UUID, assigned when the row is written
  // Set only once GİB has actually accepted the filing through an integrator.
  // NULL means the document was never filed: the exporter marks it as carrying
  // no fiscal value rather than claiming a fiscal seal it does not have.
  gibEnvelopeId String?
  // The provider payment this invoice was issued for. Unique per tenant, so a
  // redelivered webhook cannot issue a second invoice for one payment; NULL on
  // rows written before the write path existed (TASK-MTSWL8ADKZKDM).
  paymentRef    String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, number])
  @@unique([tenantId, paymentRef])
  @@index([tenantId, issuedAt])
}

/// The buyer's *current* fiscal identity, as the tenant supplied it.
///
/// Nothing else in the schema held this: `Tenant` carries a display name and an
/// ISO country code, and the billing panel used to read the buyer identity back
/// off the newest invoice, which only ever echoes what an earlier invoice
/// already claimed. Without a store, filling `Invoice.buyer*` would mean
/// inventing a taxpayer (TASK-MTSWL8ADKZKDM).
///
/// This row is mutable; `Invoice.buyer*` is the snapshot frozen at issue time.
/// Correcting a typo here never rewrites a document already sent to a customer.
/// A tenant with no row here is not invoiced at all — a SystemAlert names the
/// missing fields instead.
model TenantBillingIdentity {
  tenantId       String   @id
  buyerName      String
  buyerVknTckn   String             // 10-digit VKN or 11-digit TCKN, as supplied by the buyer
  buyerTaxOffice String
  buyerAddress   String
  buyerCity      String
  buyerCountry   String   @default("Türkiye")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id        String   @id @default(cuid())
  tenantId  String
  delta     Int      // + grant, - usage
  reason    String   // monthly_grant | purchase | usage:M2 | refund
  refId     String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
}

// ───────────────────────── K1 Calls (shared, not tenant-scoped) ─────────────────────────

model Programme {
  id        String @id          // "HE", "DEP", "EUROSTARS", "CETP", "DUT", "ERASMUS", "EIT", "EUREKA", "TUBITAK"
  name      String
  sourceKey String             // adapter key
  calls     Call[]
}

model Call {
  id           String   @id @default(cuid())
  programmeId  String
  callIdentifier String @unique   // e.g. HORIZON-CL5-2026-09
  title        String
  openDate     DateTime?
  budgetCents  BigInt?
  currency     String   @default("EUR")
  url          String?
  programme    Programme @relation(fields: [programmeId], references: [id])
  topics       Topic[]
}

model Topic {
  id             String   @id @default(cuid())
  callId         String
  identifier     String   @unique // HORIZON-CL5-2026-09-D4-01
  title          String
  status         TopicStatus @default(FORTHCOMING)
  typeOfAction   String?   // RIA IA CSA ...
  isLumpSum      Boolean  @default(false)
  isTwoStage     Boolean  @default(false)
  budgetPerProjectCents BigInt?
  numProjects    Int?
  deadlines      Json     // [{stage:1, at:"2026-09-15T17:00:00Z", tz:"Europe/Brussels"}]
  nextDeadlineAt DateTime?
  eligibility    Json     @default("{}") // { restricted: "EU_EEA_CH_ONLY" | null, countriesExcluded: [] , notes }
  destination    String?
  keywords       String[]
  description    String?  // expected outcomes + scope (from topicDetails)
  sourceUrl      String?
  rawHash        String?
  embedding      Unsupported("vector(1536)")?
  fetchedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  call           Call     @relation(fields: [callId], references: [id])
  matches        TopicMatch[]
  stats          TopicStat[]
  @@index([nextDeadlineAt])
  @@index([status])
}

enum TopicStatus {
  FORTHCOMING
  OPEN
  CLOSED
}

model TopicStat {                 // K3 — Horizon Dashboard imports (shared)
  id            String @id @default(cuid())
  topicId       String?
  topicPrefix   String            // e.g. HORIZON-CL5-2025-02-D4
  country       String?           // null = all
  orgType       String?
  proposals     Int?
  funded        Int?
  successRate   Float?
  source        String            // "horizon-dashboard-2026Q3"
  importedAt    DateTime @default(now())
  topic         Topic?   @relation(fields: [topicId], references: [id])
  @@index([topicPrefix])
}

model RawFetch {
  id        String   @id @default(cuid())
  source    String
  key       String
  hash      String
  storageUrl String?
  payload   Json?
  fetchedAt DateTime @default(now())
  @@index([source, key])
}

/// Operator-visible alerts. Deliberately tenant-agnostic and NOT covered by
/// prisma/rls.sql — never write tenant content here, only a reference to the
/// tenant-scoped row (see src/lib/observability/system-alert.ts).
model SystemAlert {
  id        String   @id @default(cuid())
  level     String   // info|warn|error
  source    String
  message   String
  meta      Json?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([createdAt])
  @@index([source, createdAt])
  @@index([resolvedAt, createdAt])
}

// ───────────────────────── K1 tenant-scoped ─────────────────────────

/// Two kinds of row live here, told apart by `opportunityId`:
///
///   • `opportunityId = NULL` — the K1 match for a tenant × topic. `fitScore` (cosine + rule
///     corrections) is a property of the *topic*, so exactly one such row exists per pair.
///   • `opportunityId` set — the G0 evidence record for one opportunity: `g0Score` and the
///     per-criterion `breakdown` that CLAUDE.md §7 requires behind the figure on screen.
///
/// The split exists because a G0 score is *not* a property of the topic. `budgetRoleEconomy`
/// (weight 10) reads `Opportunity.intendedRole` and `researchAndEndUser` (weight 12) reads that
/// opportunity's `ConsortiumSeat` rows, so two opportunities on the same topic score differently
/// — and `Opportunity.topicId` is not unique. While this table was keyed `[tenantId, topicId]`
/// the second scoring run overwrote the first and the board, which reads this record, drew one
/// opportunity's score on the other one's card: measured 44.9 vs 48.23 on the same topic, with
/// both cards showing 48.23 (TASK-MTQ63RR8Z0G8E).
///
/// The unique index is created `NULLS NOT DISTINCT` (Postgres >= 15) in
/// prisma/migrations/topicmatch-per-opportunity/migration.sql, so the K1 row stays one-per-pair
/// even though `opportunityId` is NULL there — Prisma cannot express that nuance, which is why
/// the K1 row is read and written with findFirst/create rather than an upsert on the compound key.
model TopicMatch {
  id        String   @id @default(cuid())
  tenantId  String
  topicId   String
  /// The opportunity this G0 evidence belongs to; NULL on a topic-level K1 match row.
  opportunityId String?
  fitScore  Float    // 0..100
  g0Score   Float?   // weighted total
  breakdown Json     // per-criterion
  computedAt DateTime @default(now())
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([tenantId, topicId, opportunityId])
  @@index([tenantId, g0Score])
  @@index([tenantId, opportunityId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  name      String
  filters   Json
  notify    Boolean  @default(true)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  @@index([tenantId])
}

// ───────────────────────── K2 CORDIS & M1 Derived Tables (shared) ─────────────────────────

model CordisProject {
  id                 String     @id // CORDIS project id (PK)
  rcn                String?
  acronym            String?
  title              String
  objective          String?    @db.Text
  status             String?
  framework          String     // HORIZON | H2020
  masterCall         String?
  subCall            String?
  fundingScheme      String?
  legalBasis         String?
  startDate          DateTime?
  endDate            DateTime?
  ecSignatureDate    DateTime?
  totalCost          BigInt?
  ecMaxContribution  BigInt?
  grantDoi           String?
  contentUpdateDate  DateTime?
  rawJson            Json?
  importedAt         DateTime   @default(now())

  participations     CordisParticipation[]
  topics             CordisProjectTopic[]
  scivocs            CordisProjectSciVoc[]

  @@index([startDate])
  @@index([masterCall])
  @@index([framework])
}

model CordisOrganization {
  organisationId     String     @id // CORDIS organisationID (PIC)
  name               String
  nameNormalized     String?
  shortName          String?
  vatNumber          String?
  activityType       String?    // HES | REC | PRC | PUB | OTH
  sme                Boolean    @default(false)
  country            String?
  city               String?
  postCode           String?
  nutsCode           String?
  geolocation        String?
  url                String?
  isTurkish          Boolean    @default(false)
  rawJson            Json?
  updatedAt          DateTime   @updatedAt

  participations     CordisParticipation[]
  profile            CordisPartnerProfile?

  @@index([country])
  @@index([activityType])
  @@index([nameNormalized])
  @@index([isTurkish])
}

model CordisParticipation {
  projectId          String
  organisationId     String
  role               String     // coordinator | participant | thirdParty...
  order              Int?
  ecContribution     BigInt?
  netEcContribution  BigInt?
  totalCost          BigInt?
  endOfParticipation Boolean?   @default(false)
  active             Boolean?   @default(true)

  project            CordisProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization       CordisOrganization @relation(fields: [organisationId], references: [organisationId], onDelete: Cascade)

  @@id([projectId, organisationId])
  @@index([organisationId])
  @@index([projectId])
  @@index([role])
}

model CordisProjectTopic {
  projectId          String
  topicCode          String
  topicTitle         String?

  project            CordisProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, topicCode])
  @@index([topicCode])
}

model CordisProjectSciVoc {
  projectId          String
  scivocCode         String
  scivocPath         String?
  scivocTitle        String?

  project            CordisProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, scivocCode])
}

model CordisImportRun {
  runId              String     @id @default(cuid())
  dataset            String     // HORIZON | H2020
  startedAt          DateTime   @default(now())
  finishedAt         DateTime?
  status             String     // RUNNING | SUCCESS | FAILED
  fileHash           String?
  rowCounts          Json?      // { projects: N, organizations: N, participations: N }
  error              String?    @db.Text
}

model CordisPartnerProfile {
  organisationId        String     @id
  name                  String
  nameNormalized        String?
  country               String?
  activityType          String?
  sme                   Boolean    @default(false)
  isTurkish             Boolean    @default(false)
  
  totalProjects         Int        @default(0)
  horizonProjects       Int        @default(0)
  h2020Projects         Int        @default(0)
  coordinatorProjects   Int        @default(0)
  activeProjects        Int        @default(0)
  totalEcContribution   BigInt     @default(0)
  lastProjectDate       DateTime?

  topTopics             Json       @default("[]") // top 20 [{code, title, count}]
  topCountries          Json       @default("[]") // top 20 [{country, count}]
  topPartners           Json       @default("[]") // top 20 [{organisationId, name, country, count}]

  updatedAt             DateTime   @updatedAt
  organization          CordisOrganization @relation(fields: [organisationId], references: [organisationId], onDelete: Cascade)

  @@index([country, activityType])
  @@index([totalProjects])
  @@index([coordinatorProjects])
  @@index([isTurkish])
}

model CordisCoParticipation {
  orgA                  String
  orgB                  String
  sharedProjectCount    Int        @default(0)
  lastSharedYear        Int?

  @@id([orgA, orgB])
  @@index([orgA])
  @@index([orgB])
}

// ───────────────────────── K5 Pipeline (tenant-scoped) ─────────────────────────

model Opportunity {
  id           String   @id @default(cuid())
  tenantId     String
  workspaceId  String
  topicId      String?
  title        String
  stage        Gate     @default(G0)
  status       OppStatus @default(ACTIVE)
  intendedRole String?  // coordinator | partner
  ownerId      String?
  g0Score      Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proposal     Proposal?
  gateDecisions GateDecision[]
  seats        ConsortiumSeat[]
  efforts      Effort[]
  topicMatches TopicMatch[]
  @@index([tenantId, workspaceId, stage])
  followupDocs FollowupDoc[]
  applicationParts ApplicationPart[]
  evaluations Evaluation[]
  @@index([deletedAt])
}

enum Gate {
  G0
  G1
  G2
  G3
  G4
}
enum OppStatus {
  ACTIVE
  WITHDRAWN
  SUBMITTED
  FUNDED
  REJECTED
  ABOVE_THRESHOLD
}

model GateDecision {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String
  gate          Gate
  passed        Boolean
  inputs        Json     // values evaluated
  ruleVersion   String
  decidedBy     String
  decidedAt     DateTime @default(now())
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String?
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@index([tenantId, opportunityId])
  @@index([deletedAt])
}

model ConsortiumSeat {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String
  roleKey       String   // coordinator | research | industry | end_user | widening | dissemination | custom
  required      Boolean  @default(true)
  organizationId String? // filled seat (CORDIS PIC) or
  partnerOrgId  String?  // tenant-private partner record
  status        SeatStatus @default(OPEN)
  budgetCents   BigInt?
  personMonths  Float?
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@index([tenantId, opportunityId])
}

enum SeatStatus {
  OPEN
  CANDIDATE
  INVITED
  CONFIRMED
  DECLINED
}

model PartnerOrg {                 // tenant-private orgs not in CORDIS
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  country   String?
  orgType   String?
  pic       String?
  website   String?
  createdAt DateTime @default(now())
  @@index([tenantId])
}

model Proposal {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String   @unique
  acronym       String?
  submittedAt   DateTime?
  esrScores     Json?    // {excellence, impact, implementation, total, threshold}
  esrFileUrl    String?
  outcome       String?  // funded | reserve | above_threshold | below
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String?
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  evaluations   Evaluation[]
  @@index([deletedAt])
}

model Effort {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String
  userId        String
  date          DateTime
  hours         Float
  note          String?
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String?
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@index([tenantId, opportunityId])
  @@index([deletedAt])
}

// ───────────────────────── M3 Evidence Pack ─────────────────────────

model Evidence {
  id                 String               @id @default(cuid())
  tenantId           String
  kind               String               // corporate | financial | certificate | infrastructure | performance | ethics | partner | personnel
  category           String               @default("certificate") // CAT-01 .. CAT-08
  title              String
  body               String               @db.Text
  description        String?              @db.Text
  language           String               @default("tr") // tr | en | bilingual
  issuingAuthority   String?              // TSE, İTO, TÜRKAK, Audit Firm
  documentNumber     String?              // Certificate / Doc No
  issuedAt           DateTime?
  validFrom          DateTime?
  validUntil         DateTime?
  confidentiality    String               @default("INTERNAL") // PUBLIC | CONSORTIUM | INTERNAL | RESTRICTED
  status             String               @default("VALID") // UNVERIFIED | VALID | EXPIRING_SOON | EXPIRED | REJECTED
  version            Int                  @default(1)
  
  // Cloudflare R2 Depolama Bilgileri
  r2ObjectKey        String?              // tenantId/orgId/cat/hash.ext
  fileBucket         String               @default("fonbridge-evidence")
  fileName           String?
  fileSizeBytes      Int?
  mimeType           String?
  checksumSha256     String?
  fileUrl            String?
  sourceUrl          String?
  sourceDate         DateTime?

  // YZ & OCR Metadata
  ocrText            String?              @db.Text
  extractedFields    Json                 @default("{}")
  tags               String[]
  lastUsedIn         String?              // proposalId
  createdBy          String               @default("system")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  claimLinks         ClaimEvidenceLink[]
  proposalUsages     ProposalUsage[]
  reminders          EvidenceReminder[]

  @@index([tenantId, kind])
  @@index([tenantId, category])
  @@index([tenantId, status])
  @@index([validUntil])
}

model Claim {
  id                 String               @id @default(cuid())
  tenantId           String
  statement          String               @db.Text
  statementEn        String?              @db.Text
  confidenceScore    Float                @default(1.0)
  tags               String[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  evidenceLinks      ClaimEvidenceLink[]

  @@index([tenantId])
}

// Every row is a join between one tenant's Claim and that same tenant's
// Evidence, so it is tenant data even though it looks like a pure link table.
// `tenantId` is carried on the row itself: RLS reads a column, it does not
// follow a foreign key (TASK-MTU6HUB8FUHMG B-1).
model ClaimEvidenceLink {
  id                 String               @id @default(cuid())
  tenantId           String
  claimId            String
  evidenceId         String
  isPrimary          Boolean              @default(true)
  notes              String?

  claim              Claim                @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence           Evidence             @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([claimId, evidenceId])
  @@index([tenantId])
}

model ProposalUsage {
  id                 String               @id @default(cuid())
  tenantId           String
  opportunityId      String
  evidenceId         String
  sectionKey         String               // "PartB_Sec3_2", "Annex_4", "ConceptNote_G0"
  usedAt             DateTime             @default(now())
  usedByUserId       String?

  evidence           Evidence             @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([tenantId, opportunityId])
}

// `recipientEmails` is personal data, so a row here is tenant data twice over:
// it hangs off one tenant's Evidence and it names that tenant's people. Carried
// on the row so RLS can see it (TASK-MTU6HUB8FUHMG B-1).
model EvidenceReminder {
  id                 String               @id @default(cuid())
  tenantId           String
  evidenceId         String
  notifyAt           DateTime
  sent               Boolean              @default(false)
  recipientEmails    String[]

  evidence           Evidence             @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sent, notifyAt])
}

// ───────────────────────── M2 Concept Note ─────────────────────────

model ConceptTemplate {             // platform + tenant templates
  id        String  @id @default(cuid())
  tenantId  String? // null = platform
  key       String  // cetp_pre, dut_pre, eurostars_summary, he_stage1_blind, eic_step1, hopon
  name      String
  schema    Json    // sections[] {key,labelKey,maxWords,promptKey}
  version   String
}

model ConceptNote {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String
  templateId    String
  content       Json     // {sectionKey: markdown}
  status        String   @default("draft") // draft | review | approved
  version       Int      @default(1)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([tenantId, opportunityId])
}

// ───────────────────────── M4 Focal Point ─────────────────────────

/// `ownerUserId` is a work assignment, not a record: it names the internal
/// focal point who currently owns this relationship. No integrity rule depends
/// on it and the external party is held separately in `counterpartName` /
/// `counterpartEmail`, so there is no legal basis to keep it once that person
/// is erased. It is therefore nullable and the erasure purge detaches it
/// (`users-scheduled-deletion`); NULL means "unassigned — needs a new focal
/// point", which is also the state a relationship lands in after an erasure.
/// Decided 2026-09-08, A4 option C: the sibling case `DualApprovalStep.actorUserId`
/// went the other way and is retained, because there an approval is a signature.
model Relationship {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String?  // CORDIS PIC
  partnerOrgId   String?
  kind           String   // partner | ncp | city | cluster | consultant | tto
  ownerUserId    String?  // internal focal point; NULL = unassigned (or erased)
  counterpartName String?
  counterpartEmail String?
  warmth         String   @default("cold") // cold | warm | hot | active
  lastContactAt  DateTime?
  nextStep       String?
  nextStepDue    DateTime?
  notes          String?
  updatedAt      DateTime @updatedAt
  @@index([tenantId, ownerUserId])
  @@index([tenantId, lastContactAt])
}

model Interaction {
  id             String   @id @default(cuid())
  tenantId       String
  relationshipId String
  kind           String   // meeting | email | call | event
  at             DateTime
  summary        String?
  briefId        String?   // M9
  createdBy      String
  @@index([tenantId, relationshipId])
}

// ───────────────────────── M8 Consortium Matching ─────────────────────────

model SeatCandidate {
  id             String @id @default(cuid())
  tenantId       String
  seatId         String
  organizationId String?
  partnerOrgId   String?
  score          Float
  breakdown      Json
  rank           Int
  computedAt     DateTime @default(now())
  @@index([tenantId, seatId, rank])
}

// ───────────────────────── K6 AI ─────────────────────────

model AiUsageLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  module      String
  purpose     String
  provider    String
  model       String
  promptHash  String
  inputTokens Int
  outputTokens Int
  credits     Int
  proposalId  String?
  section     String?
  createdAt   DateTime @default(now())
  @@index([tenantId, createdAt])
  @@index([tenantId, proposalId])
}

model Document {
  id        String   @id @default(cuid())
  tenantId  String?  // null = shared public (work programmes)
  kind      String   // work_programme | topic | cordis_summary | tenant_upload
  title     String
  sourceUrl String?
  fileUrl   String?
  createdAt DateTime @default(now())
  chunks    Chunk[]
}

model Chunk {
  id         String @id @default(cuid())
  documentId String
  tenantId   String?
  ordinal    Int
  text       String
  embedding  Unsupported("vector(1536)")?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@index([documentId])
}

// ───────────────────────── Audit ─────────────────────────

// `tenantId` is nullable on purpose: a KVKK/GDPR erasure request from a user
// who belongs to no tenant still has to leave a trail
// (src/actions/user/request-deletion.ts). So this table takes the
// `tenant_or_shared` policy, not `tenant_isolation` — under strict isolation
// `NULL = 'x'` is not true and that row could be neither written nor read
// (TASK-MTU6HUB8FUHMG C-2).
model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  actorId   String?
  type      String   // module.state.changed | gate.decided | subscription.updated | ...
  target    String?
  data      Json?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
}

// ───────────────────────── v1.1+ (M6, M9, M10, M11, M7, marketplace) ─────────────────────────


// M6 Evaluator Lens.
// Two shapes share this table, distinguished by `readerType`:
//   HUMAN | AI    — single-reader lens on an Opportunity (v1.0, excellence/impact/implementation)
//   PANEL         — multi-reviewer panel on a Proposal (v1.1, reviewers + criteria + scores)
// The v1.1 columns are all nullable or defaulted, so existing v1.0 rows and callers are unaffected.
model Evaluation {
  id             String      @id @default(cuid())
  tenantId       String
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  proposalId     String?     // v1.1 — set for PANEL evaluations
  proposal       Proposal?   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId         String?     // owning evaluator / creator
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  readerType     String      @default("HUMAN") // "HUMAN" | "AI" | "PANEL"
  status         String      @default("draft") // draft | in-progress | completed
  avgScore       Float?      // weighted 1-5 panel average; null until reviewers submit
  excellence     Float       @default(0)
  impact         Float       @default(0)
  implementation Float       @default(0)
  weaknesses     Json?
  calibration    Float?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  reviewers      Reviewer[]
  criteria       Criterion[]
  @@index([tenantId, proposalId])
  @@index([tenantId, opportunityId])
}

// One assigned reviewer on a PANEL evaluation. A user may sit on an evaluation once.
model Reviewer {
  id           String     @id @default(cuid())
  tenantId     String
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String     @default("evaluator") // evaluator | coordinator
  status       String     @default("pending")   // pending | completed
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  scores       Score[]
  @@unique([evaluationId, userId])
  @@index([evaluationId, status])
  @@index([tenantId])
}

// A weighted scoring axis of a PANEL evaluation. Weights are 0..1 and should sum to 1 per evaluation.
model Criterion {
  id           String     @id @default(cuid())
  tenantId     String
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  name         String     // Innovation | Feasibility | Impact | Communication
  weight       Float      @default(0)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  scores       Score[]
  @@unique([evaluationId, name])
  @@index([tenantId, evaluationId])
}

// One reviewer's mark on one criterion. score is 1..5 (DB CHECK in the M6 migration).
// submittedAt stays null while the reviewer is still drafting.
model Score {
  id          String    @id @default(cuid())
  tenantId    String
  reviewerId  String
  reviewer    Reviewer  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  score       Int
  comment     String?   @db.Text
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  @@unique([reviewerId, criterionId])
  @@index([criterionId])
  @@index([tenantId])
}

model MeetingBrief {
  id                  String      @id @default(cuid())
  tenantId            String
  interactionId       String      @unique
  partnerName         String?
  content             String
  meetingScheduledAt  DateTime?   // UTC meeting time
  meetingScheduledTz  String      @default("Europe/Brussels")
  createdAt           DateTime    @default(now())
}

model CalendarConnection {
  id                String    @id @default(cuid())
  tenantId          String
  userId            String
  provider          String    // 'google' | 'outlook' | 'ics'
  externalId        String?   // Google: calendar ID, Outlook: mailbox address
  accessToken       String?   // Plaintext. Column is unpopulated today — no OAuth writer exists yet
                               // (google/outlook `connectCalendar` refuses with CALENDAR_OAUTH_NOT_CONFIGURED,
                               // `/api/calendar/callback` does not exist). Must be encrypted before that
                               // OAuth flow ships — see docs/ROADMAP.md open decision #12, TASK-MTSHP3BMTAD3Y.
  refreshToken      String?   // Same as accessToken above.
  tokenExpiresAt    DateTime?
  isConnected       Boolean   @default(true)
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, userId, provider])
  @@index([tenantId])
  @@index([userId])
}

model FollowupDoc {
  id             String      @id @default(cuid())
  tenantId       String
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  kind           String      // NDA, LOI, COMMITMENT, ESR_DEBRIEF, AWARD_PACK
  version        Int         @default(1)
  contentUrl     String?
  signedAt       DateTime?
  createdAt      DateTime    @default(now())

  // M10 dual approval — the submission that opens the flow (TASK-MTSAIWF4ENUSL).
  // The two department sign-offs live in DualApprovalStep; the final signature is
  // `signedAt` above. `approvalSubmittedByName` is a snapshot of the display name
  // as the session carried it, so the record stays readable after a rename.
  approvalSubmittedAt     DateTime?
  approvalSubmittedById   String?
  approvalSubmittedByName String?

  approvalSteps  DualApprovalStep[]
}

/// One department sign-off in the M10 dual approval flow (FINANCE or LEGAL).
///
/// The two four-eyes rules are unique indexes, not app-level checks:
///   @@unique([followupDocId, department])  — a department signs a document once
///   @@unique([followupDocId, actorUserId]) — a person signs at most one department
/// `actorUserId` is deliberately not a foreign key: an approval is a signature, and
/// the record must outlive a change to the user row that made it.
model DualApprovalStep {
  id            String      @id @default(cuid())
  tenantId      String
  followupDocId String
  followupDoc   FollowupDoc @relation(fields: [followupDocId], references: [id], onDelete: Cascade)
  department    String      // FINANCE | LEGAL
  actorUserId   String
  actorName     String
  note          String?
  decidedAt     DateTime    @default(now())

  @@unique([followupDocId, department])
  @@unique([followupDocId, actorUserId])
  @@index([tenantId, followupDocId])
}

model ApplicationPart {
  id             String      @id @default(cuid())
  tenantId       String
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  part           String      // PART_A, PART_B
  content        Json?       // Section tree, budget tables, etc.
  magicToken     String?     @unique // For external partner access
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model TtoPortfolioItem {
  id           String   @id @default(cuid())
  tenantId     String
  title        String
  trl          Int      @default(5)
  patentStatus String   // pending | granted | licensed
  summary      String
  keywords     String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([tenantId])
}

model MarketplaceListing {
  id          String   @id @default(cuid())
  tenantId    String
  kind        String   // service | patent_license | consultancy
  title       String
  description String
  price       String?  // e.g. "€2,500" or "Negotiable"
  status      String   @default("active") // active | unlisted | fulfilled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenantId, kind])
}

model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  keyHash     String    @unique
  prefix      String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  @@index([tenantId])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  tenantId  String
  role      Role     @default(MEMBER)
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([email, tenantId])
}

model ApprovalRequest {
  id              String         @id @default(cuid())
  tenantId        String
  workspaceId     String?
  actionType      String         // GATE_G4_SUBMISSION | BUDGET_ALLOCATION | LEGAL_COMMITMENT | MEMBER_ROLE_ELEVATION | SENSITIVE_SETTINGS_CHANGE
  title           String
  description     String?
  payload         Json
  status          ApprovalStatus @default(PENDING)
  requiredRole    Role           @default(TENANT_ADMIN)
  requesterId     String
  approverId      String?
  rejectionReason String?
  auditHash       String?
  expiresAt       DateTime
  executedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester       User           @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  approver        User?          @relation("Approver", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([requesterId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}


// ───────────────────────── E11 Beta · feedback & triage ─────────────────────────

/// In-product feedback from beta design partners. Written first and always: the
/// SystemAlert write is best-effort, so a failure on the observability side must
/// never lose a partner's report. `autoPriority` keeps what the rule engine
/// decided even after a human overrides `priority` — that gap is how the rules
/// get calibrated during the beta.
model Feedback {
  id            String            @id @default(cuid())
  tenantId      String
  userId        String?
  workspaceSlug String?
  category      FeedbackCategory
  impact        FeedbackImpact    @default(MINOR)
  priority      FeedbackPriority  @default(P3)
  autoPriority  FeedbackPriority  @default(P3)
  status        FeedbackStatus    @default(NEW)
  title         String
  body          String
  triageReason  String?           // which rule fired, for auditability
  pageUrl       String?
  userAgent     String?
  appVersion    String?
  locale        String            @default("tr")
  screenshotKey String?           // R2 object key; the URL is signed on demand
  alertId       String?           // SystemAlert.id raised for this report
  alertStatus   String?           // recorded | failed ('legacy' = predates the SystemAlert channel)
  triageNote    String?
  triagedById   String?
  triagedAt     DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status, priority])
  @@index([priority, status])
  @@index([createdAt])
}

enum FeedbackCategory {
  BUG
  FEATURE_REQUEST
  UX
  PERFORMANCE
  DATA_QUALITY
  OTHER
}

/// What the reporter says the report costs them. Combined with category and a
/// keyword scan in src/lib/feedback/triage.ts to produce P0–P3.
enum FeedbackImpact {
  BLOCKER   // cannot work at all
  MAJOR     // major function unusable, no workaround
  MINOR     // annoying, workaround exists
