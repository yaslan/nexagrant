#!/bin/sh
# Push, kodun bu makineden ÇIKTIĞI andır: burada tam kapı koşar, kısaltma yok.
set -e
# Git kancayı GIT_DIR (worktree'de ayrıca GIT_INDEX_FILE) set ederek çalıştırır.
# Gate bunları devralırsa başka cwd'de git çağıran her şey (ör. geçici fixture
# repo kuran testler) BU reponun indeksini okur ve ona `git add` yazar (FO-111).
# Kancanın cwd'si checkout kökü; git repoyu buradan kendisi bulur.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX
# NG-331 (B1): git push edilen ref'leri stdin'den verir: "<yerel-ref> <yerel-sha> <uzak-ref> <uzak-sha>".
# Kapı HEAD'i sınar; push edilen commit HEAD değilse yeşil kapı yanlış kanıt olur (HEAD yeşil, push edilen kırmızı).
# Bu yüzden her silme-olmayan satırda yerel-sha == HEAD şart. Silme push'u (yerel-sha tümü 0) kod taşımaz: muaf
# (lider kararı; docs/GATE.md). stdin pnpm gate'e kalmasın diye en başta okunur.
refs=$(cat)
head_sha=$(git rev-parse HEAD)
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  if [ "$local_sha" != "$head_sha" ]; then
    echo "pre-push: push edilen commit HEAD değil ($local_ref = $local_sha, HEAD = $head_sha); push durduruldu." >&2
    echo "  Kapı yalnız HEAD'i sınar. Önce o commit'i checkout edin, sonra push edin." >&2
    exit 1
  fi
done <<EOF
$refs
EOF
# Paylaşılan .git/config'te core.bare=true ise dur; ayarı kendimiz düzeltmeyiz (FO-114).
. scripts/git-core-bare.sh
core_bare_guard pre-push || exit 1
# Kapının veritabanı bu checkout'un .env'inden gelir (vitest, playwright ve
# tsx betikleri cwd'deki .env'i okur). .env yoksa testler varsayılan
# localhost:5432'ye düşer ve onlarca test ortam yüzünden kırmızı olur
# (TASK-MVBFDSUSE5QCY). Worktree tarifi: CLAUDE.md "Worktree'de gate".
if [ -z "${DATABASE_URL:-}" ] && [ ! -f .env ]; then
  echo "pre-push: bu checkout'ta .env yok ve DATABASE_URL tanımlı değil; kapı hangi veritabanına karşı koşacağını bilmiyor." >&2
  echo "  Worktree'de izole DB kur: CLAUDE.md \"Worktree'de gate\" (docker run … + .env + pnpm db:setup)." >&2
  exit 1
fi
# Yalnız host:port/db yazılır; parola ve girdinin kendisi hiçbir zaman basılmaz (scripts/db-target.sh).
. scripts/db-target.sh
db=${DATABASE_URL:-$(db_env_value .env)}
echo "→ veritabanı: $(db_target "$db")"
# FO-203: localhost URL'si Postgres'i yalnız 127.0.0.1'de buluyorsa ::1 tarafı sahipsizdir;
# başka bir süreç o portu alınca psql kırılır ve gate rastgele kırmızı verir. Gate'ten önce dur.
node scripts/db-loopback-check.mjs || exit 1
# FO-339: aynı tree için yeşil kayıt varsa gate-lock "önbellek: <tree> <tarih>" basıp döner;
# yalnız belge farkıysa lint + i18n:check. Kod dokunulmuşsa tam gate koşar (kısaltma yok).
echo "→ pnpm gate (önbellek / belge-yalnız / tam gate: gate-lock karar verir)"
# NG-331: kapı kırmızıysa push durur; çıkış kodu gerçek kapıdan gelir (sabit 0 değil). set -e de durdurur,
# bu satır nedeni açıkça yazar. Atlatma yolu yok: pnpm gate dışında hiçbir ortam değişkeni bu adımı kapatmaz.
pnpm gate || {
  rc=$?
  echo "pre-push: KAPI KIRMIZI (çıkış $rc); push durduruldu. Ayrıntı yukarıda; --no-verify kullanma." >&2
  exit "$rc"
}
# FO-114: core.bare'i kimin yazdığı kanıtlanmadı; gate (GIT_DIR sızıntısı + git init) muhtemel
# yazıcı, doğrulanmadı (docs/RELEASE_CHECKLIST.md §9.1).
# Gate yeşil olsa bile ana checkout'u bozduysa push etme.
core_bare_guard "pre-push (gate sonrası)" || exit 1
