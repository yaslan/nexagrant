// Anonymous person-announcement count per topic; no person row exists anywhere.
model PartnerSearchTopicStat {
  topicIdentifier         String   @id // Topic.identifier
  personAnnouncementCount Int      @default(0)
  updatedAt               DateTime @updatedAt
  topic                   Topic    @relation(fields: [topicIdentifier], references: [identifier], onDelete: Cascade)
}

// Tenant-scoped: Discover queries per tenant per month. RLS tenant_isolation, written inside withTenant.
model PartnerSearchQuotaUsage {
