// ───────────────────────── M3 Evidence Pack ─────────────────────────

/// NG-239: where an Evidence file's virus scan stands. Only CLEAN downloads.
enum EvidenceScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

model Evidence {
  id                 String               @id @default(cuid())
  tenantId           String
  kind               String               // corporate | financial | certificate | infrastructure | performance | ethics | partner | personnel
  category           String               @default("certificate") // CAT-01 .. CAT-08
  title              String
  body               String               @db.Text
  description        String?              @db.Text
  language           String               @default("tr") // tr | en | bilingual
  issuingAuthority   String?              // TSE, İTO, TÜRKAK, Audit Firm
  documentNumber     String?              // Certificate / Doc No
  issuedAt           DateTime?
  validFrom          DateTime?
  validUntil         DateTime?
  confidentiality    String               @default("INTERNAL") // PUBLIC | CONSORTIUM | INTERNAL | RESTRICTED
  status             String               @default("VALID") // UNVERIFIED | VALID | EXPIRING_SOON | EXPIRED | REJECTED
  version            Int                  @default(1)
  
  // Cloudflare R2 Depolama Bilgileri
  r2ObjectKey        String?              // tenantId/orgId/cat/hash.ext
  fileBucket         String               @default("fonbridge-evidence")
  fileName           String?
  fileSizeBytes      Int?
  mimeType           String?
  checksumSha256     String?
  fileUrl            String?
  sourceUrl          String?
  sourceDate         DateTime?

  // Virus scan of the stored file (NG-239, §18.3). Only CLEAN leaves through a
  // download (src/lib/evidence-scan-gate.ts). PENDING until the `evidence-scan`
  // job has asked clamd; ERROR = clamd unreachable / timed out / object
  // unreadable, retried; INFECTED = the object was deleted.
  // prisma/migrations/add-evidence-scan-status.sql
  scanStatus         EvidenceScanStatus   @default(PENDING)
  scannedAt          DateTime?
  scanSignature      String?
  scanAttempts       Int                  @default(0)

  // YZ & OCR Metadata
  ocrText            String?              @db.Text
  extractedFields    Json                 @default("{}")
  tags               String[]
  lastUsedIn         String?              // proposalId
  createdBy          String               @default("system")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  claimLinks         ClaimEvidenceLink[]
  proposalUsages     ProposalUsage[]

  // One row per stored object (D-3, TASK-MUNTTZ94LJWBC): confirming the same
  // key twice made two rows, and deleting either removed the other's file.
  // prisma/migrations/evidence-unique-object-key.sql
  @@unique([tenantId, r2ObjectKey])
  @@index([tenantId, scanStatus])
  @@index([tenantId, kind])
  @@index([tenantId, category])
  @@index([tenantId, status])
  @@index([validUntil])
}

model Claim {
  id                 String               @id @default(cuid())
  tenantId           String
  statement          String               @db.Text
  statementEn        String?              @db.Text
  confidenceScore    Float                @default(1.0)
  tags               String[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  evidenceLinks      ClaimEvidenceLink[]

  @@index([tenantId])
}

// Every row is a join between one tenant's Claim and that same tenant's
// Evidence, so it is tenant data even though it looks like a pure link table.
// `tenantId` is carried on the row itself: RLS reads a column, it does not
// follow a foreign key (TASK-MTU6HUB8FUHMG B-1).
model ClaimEvidenceLink {
  id                 String               @id @default(cuid())
  tenantId           String
  claimId            String
  evidenceId         String
  isPrimary          Boolean              @default(true)
  notes              String?

  claim              Claim                @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence           Evidence             @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([claimId, evidenceId])
  @@index([tenantId])
}

model ProposalUsage {
  id                 String               @id @default(cuid())
  tenantId           String
  opportunityId      String
  evidenceId         String
  sectionKey         String               // "PartB_Sec3_2", "Annex_4", "ConceptNote_G0"
  usedAt             DateTime             @default(now())
  usedByUserId       String?

  evidence           Evidence             @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([tenantId, opportunityId])
}

// ───────────────────────── M2 Concept Note ─────────────────────────

model ConceptTemplate {             // platform + tenant templates
  id        String  @id @default(cuid())
  tenantId  String? // null = platform
  key       String  // cetp_pre, dut_pre, eurostars_summary, he_stage1_blind, eic_step1, hopon
  name      String
  schema    Json    // sections[] {key,labelKey,maxWords,promptKey}
  version   String
}

