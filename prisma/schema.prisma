  @@unique([id, tenantId])
  @@index([tenantId, opportunityId])
}

// NG-34 — what G0 and G1 ask of an organisation besides its PIC (spec §12, §17.1).
// PIC has no column here: the tenant's own lives on Tenant.pic and a partner's on its seat
// or PartnerOrg; src/lib/gates/readiness-records.ts reads it from there. null = not answered,
// which is not the same as false. `subject` names the organisation:
// 'self' | 'cordis:<ConsortiumSeat.organizationId>' | 'partner:<PartnerOrg.id>'.
model OrgReadiness {
  id           String   @id @default(cuid())
  tenantId     String
  subject      String
  euLoginReady Boolean?
  learReady    Boolean?
