// Fabrika — Prisma schema (MVP scope + v1.1 tables marked)
// Conventions: PascalCase singular models, camelCase fields, tenantId on every tenant-scoped table.
// Money: Int minor units + currency. Timestamps UTC.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ───────────────────────── Tenancy & identity ─────────────────────────

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  country       String   // ISO-3166-1 alpha-2
  // TASK-MULV3JXS1AW5X — Turkish province, spelled as TR_PROVINCES
  // (src/lib/readiness/provinces.ts), the dictionary the scorecard and the
  // public-sector catalogue use. NULL = not given / not in Türkiye. A CHECK in
  // add-tenant-province.sql holds the same 81 names. Organisation data.
  province      String?
  orgType       OrgType  @default(SME)
  pic           String?  // EU Participant Identification Code
  // FO-396. Result of the EU registry lookup for `pic`: FOUND | NOT_FOUND | UNKNOWN; null = never checked.
  picRegistryStatus    String?
  picRegistryCheckedAt DateTime?
  locale        String   @default("tr")
  timezone      String   @default("Europe/Istanbul")
  settings      Json     @default("{}") // scoringWeights, gateRules, aiRegion...
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String?

  users         Membership[]
  workspaces    Workspace[]
  profile       TenantProfile?
  subscription  Subscription?
  ngSubscription NgSubscription? // NG-57
  moduleStates  ModuleState[]
  provinceLeadRoutes ProvinceLeadRoute[]
  creditLedger  CreditLedger[]
  lifetimeLicences LifetimeLicence[]
  auditEvents   AuditEvent[]
  invitations   Invitation[]
  approvalRequests ApprovalRequest[]
  invoices      Invoice[]
  billingIdentity TenantBillingIdentity?
  planAssignments PlanAssignment[]
  stripeEvents  StripeEventLog[]
  notifications Notification[]
  partnerSearchQuota PartnerSearchQuotaUsage[]
  interregAnalyses InterregAnalysis[]
  orgReadiness  OrgReadiness[]
  projectIdeas  ProjectIdea[]
  notificationPreferences NotificationPreference[]
  notificationEmailItems  NotificationEmailItem[]
  // M18 Client Pipeline (NG-143). Tenant-level; no workspace scope (lead assumption, K4).
  leadOrganizations LeadOrganization[]
  leadContacts      LeadContact[]
  leadMatches       LeadMatch[]
  deals             Deal[]
  dealActivities    DealActivity[]
  dealTasks         DealTask[]
  servicePackages   ServicePackage[]
  leadEligibilityReports LeadEligibilityReport[]
  serviceQuotes     ServiceQuote[]
  funderRules       FunderRule[]
  // FB KAMU B1 (TASK-MULRQJQYM0NAM). An agency is a tenant of kind AGENCY; a
  // tenant opened with its invite code carries its id in agencyId, written once
  // at registration. The link grants the agency no read on this tenant's rows —
  // no RLS policy consults agencyId. Migration: add-agency-invite-code.sql.
  kind          TenantKind @default(ORGANIZATION)
  agencyId      String?
  agency        Tenant?  @relation("AgencyMembers", fields: [agencyId], references: [id], onDelete: SetNull)
  agencyMembers Tenant[] @relation("AgencyMembers")
  agencyInviteCodes AgencyInviteCode[]
  @@index([deletedAt])
  @@index([agencyId])
}

enum TenantKind {
  ORGANIZATION
  AGENCY
}

/// A multi-use code an agency tenant hands out (FB KAMU B1, TASK-MULRQJQYM0NAM).
/// `tenantId` is the AGENCY — named so tenant_isolation covers it unchanged.
/// The code itself is never stored: only its SHA-256 (src/lib/agency/invite-code.ts).
/// Used only through public.redeem_agency_invite(), which increments usedCount
/// atomically and returns the agency id or NULL.
/// No use limit (TASK-MUM4WVYLSH9IT, leed-fb 29.09): a code is governed by
/// expiresAt and revokedAt only. maxUses is a retired column: nullable, never
/// written by new codes, never read. usedCount is an internal counter nobody is shown.
model AgencyInviteCode {
  id        String    @id @default(cuid())
  tenantId  String
  codeHash  String    @unique
  codeHint  String
  label     String?
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime
  revokedAt DateTime?
  revokedBy String?
  createdBy String
  createdAt DateTime  @default(now())
  agency    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

enum OrgType {
  SME
  LARGE
  UNIVERSITY
  RESEARCH
  PUBLIC
  NGO
  CONSULTANCY
  CLUSTER
  MUNICIPALITY
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified DateTime?
  image         String?
  name          String?
  locale        String   @default("tr")
  isPlatformAdmin Boolean @default(false)
  // KVKK md.7/md.11 · GDPR art.17 — erasure grace period. See prisma/migrations/add-soft-delete.sql
  deletionRequestedAt DateTime?  // set when the subject asks for erasure; purge job scans this
  deletedAt     DateTime?        // soft-delete marker: hidden from the product, still restorable
  deletionReason String?         // subject_request | policy | tenant_cascade
  /// UTC day the `m4-stale-relationships` digest for this user was claimed,
  /// set BEFORE the mail goes (compare-and-set) so no second run can send a
  /// second digest the same day. m4-stale-digest-user-claim.sql
  staleDigestOn DateTime? @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  memberships   Membership[]
  accounts      Account[]
  sessions      Session[]
  evaluations   Evaluation[]
  reviewerSeats Reviewer[]
  requestedApprovals ApprovalRequest[] @relation("Requester")
  approvedApprovals  ApprovalRequest[] @relation("Approver")
  interregAnalyses   InterregAnalysis[]
  internalApprovals  InternalApproval[]
  agreedBudgetShares PartnerBudgetShare[]
  createdProjectIdeas ProjectIdea[]
  decisions          DecisionLog[]
  @@index([deletionRequestedAt])
  @@index([deletedAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(MEMBER)
  workspaceIds String[] // empty = all workspaces of tenant
  createdAt DateTime @default(now())
  /// No longer written: the digest's claim moved to `User.staleDigestOn`
  /// (m4-stale-digest-user-claim.sql). Kept for the previous release, which
  /// still claims here; read only so that such a claim made on the deploy day
  /// holds (stale-reminder.ts `legacyClaims`). Dropped in a later file.
  /// m4-stale-reminder-idempotency.sql
  staleDigestOn DateTime? @db.Date
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
  @@index([userId])
}

enum Role {
  TENANT_OWNER
  TENANT_ADMIN
  PIPELINE_MANAGER
  WRITER
  MEMBER
  GUEST_PARTNER
}

model Workspace {
  id        String   @id @default(cuid())
  tenantId  String
  name      String   // e.g. client name for consultancies
  slug      String
  createdAt DateTime @default(now())
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  @@unique([tenantId, slug])
  @@index([deletedAt])
}

model TenantProfile {
  tenantId      String   @id
  capabilities  String   // free text, used for embedding
  keywords      String[]
  naceCodes     String[]
  trlRange      Int[]    // [min,max]
  preferredRoles String[] // coordinator, tech_provider, pilot_site, dissemination...
  priorProjects Json     @default("[]")
  embedding     Unsupported("vector(1536)")?
  embeddingHash String?  // sha256 of the text `embedding` was made from (src/lib/scoring/embeddings.ts)
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Modules & entitlements ─────────────────────────

model ModuleCatalog {           // platform-level, seeded from manifests
  id          String  @id      // "M1".."M11"
  key         String  @unique
  name        String
  version     String
  requires    String[]
  recommends  String[]
  planTiers   String[]
  addOnSku    String?
  isActive    Boolean @default(true)
}

enum ModuleStatus {
  OFF
  DEV
  PILOT
  ON
}

model ModuleState {
  id        String       @id @default(cuid())
  tenantId  String
  moduleId  String
  status    ModuleStatus @default(OFF)
  settings  Json         @default("{}")
  changedBy String?
  changedAt DateTime     @default(now())
  // FO-41: keeps the module entitled whatever the plan (M3 for pre-FO-41
  // Discover tenants). Set by migrations only; a trigger refuses fabrika_app.
  // Migration: module-state-grandfathered.sql.
  grandfathered Boolean  @default(false)
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, moduleId])
}

model Plan {                    // projection of src/lib/billing/catalog.ts; seeded: free, basic, pro, ultra
  id            String  @id    // "pro"
  name          String
  monthlyCents  Int            // list price, minor units — the campaign discount lives at checkout
  yearlyCents   Int
  currency      String  @default("USD")
  seats         Int
  workspaces    Int
  aiCreditsMonthly Int
  modules       String[]       // default ON modules
  stripePriceMonthly String?
  stripePriceYearly  String?
  visibility    String  @default("public") // public | private | archived
  versions      PlanVersion[]
  assignments   PlanAssignment[]
}

// Plan* and Subscription.planVersion FKs: onUpdate NoAction mirrors
// add-plan-versioning/migration.sql, which declares no ON UPDATE clause.
model PlanVersion {
  id            String  @id    @default(cuid())
  planId        String
  plan          Plan    @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  version       Int             // semantic version: 1, 2, 3, ...
  status        String  @default("draft") // draft | published | archived
  monthlyCents  Int
  yearlyCents   Int
  currency      String  @default("USD")
  seats         Int
  workspaces    Int
  aiCreditsMonthly Int
  modules       String[] @default([]) // modules granted by this version
  features      PlanFeature[]
  publishedBy   String?        // user id who published this version
  publishedAt   DateTime?      // when this version was published (immutable after)
  subscriptions Subscription[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([planId, version])
}

model PlanFeature {
  id            String  @id    @default(cuid())
  planVersionId String
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order         Int             // display order (1, 2, 3, ...)
  kind          String          // module | limit | text
  moduleId      String?         // if kind='module': module identifier (M1, M8, etc)
  limitKey      String?         // if kind='limit': limit identifier (e.g. "seats", "credits")
  textTr        String?         // if kind='text': Turkish label or description
  textEn        String?         // if kind='text': English label or description
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([planVersionId, order])
}

model PlanAssignment {
  id            String  @id    @default(cuid())
  planId        String
  plan          Plan    @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignedBy    String?        // user id who made the assignment
  assignedAt    DateTime @default(now())
  note          String?        // reason or memo
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([planId, tenantId])
}

model AddOnCatalog {
  sku           String @id     // "addon_m6", "addon_m11", "addon_seat_team", "addon_credits_250"
  name          String
  monthlyCents  Int?
  oneTimeCents  Int?
  currency      String @default("EUR")
  grantsModule  String?
  grantsSeats   Int?
  grantsCredits Int?
  grantsWorkspaces Int?
  stripePriceId String?
}

// NG-57 — the NexaGrant plan catalogue (NG-244 §6.1, 06-Fiyat-Politikasi). Separate from
// the Fabrika Plan/Subscription tables on purpose (K-584182 = A): NexaGrant plan ids never
// reach `getEntitlements`, whose code catalogue throws on an id it does not know.
// The four catalogue tables are platform data (RLS platform_read, no writes from
// fabrika_app); rows are seeded from prisma/seed-data/nexagrant-catalog.ts.
// Migration: add-nexagrant-plan-catalog.sql.
model NgPlan {
  id         String   @id // "ng-pro"
  tier       String // free | basic | professional | enterprise
  sortOrder  Int
  sellable   Boolean  @default(false) // meant to be bought (free and enterprise are not)
  isFallback Boolean  @default(false) // the plan of a tenant with no row or past its trial; one row at most
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  features         NgPlanFeature[]
  prices           NgPlanPrice[]
  trialPolicies    NgTrialPolicy[]  @relation("NgTrialPlan")
  trialEndPolicies NgTrialPolicy[]  @relation("NgTrialEndPlan")
  subscriptions    NgSubscription[] @relation("NgSubscriptionPlan")
  trialEndSubs     NgSubscription[] @relation("NgSubscriptionTrialEndPlan")
}

// One cell of the plan × feature matrix. A missing row = the plan does not grant the feature.
model NgPlanFeature {
  planId     String
  plan       NgPlan   @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  featureKey String // src/lib/billing/nexagrant/features.ts NG_FEATURE_KEYS
  limitValue Int? // null = unlimited; CHECK >= 0
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@id([planId, featureKey])
}

// One price cell. amountMinor null = not priced yet: not purchasable. Minor units (kuruş/cent).
// CHECK: currency IN (TRY, EUR) (K-584156 = A), interval IN (year, month), amountMinor > 0.
model NgPlanPrice {
  planId      String
  plan        NgPlan   @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  currency    String
  interval    String
  amountMinor Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([planId, currency, interval])
}

// Trial length per segment (K-584180 = A: default 14, municipality 30). CHECK days > 0.
model NgTrialPolicy {
  segment   String   @id // default | municipality
  days      Int
  planId    String
  plan      NgPlan   @relation("NgTrialPlan", fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  endPlanId String
  endPlan   NgPlan   @relation("NgTrialEndPlan", fields: [endPlanId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// The tenant's NexaGrant plan. Tenant data (tenant_isolation). No row = the fallback plan.
// The trial columns are copied from NgTrialPolicy when the trial starts, so a later policy
// change does not move a running trial's end.
model NgSubscription {
  tenantId       String    @id
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  planId         String
  plan           NgPlan    @relation("NgSubscriptionPlan", fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  status         SubStatus @default(TRIALING)
  provider       String    @default("ng-trial") // ng-trial | manual | <payment provider, undecided>
  trialSegment   String?
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  trialEndPlanId String?
  trialEndPlan   NgPlan?   @relation("NgSubscriptionTrialEndPlan", fields: [trialEndPlanId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  trialEndedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, trialEndsAt])
}

model Subscription {
  tenantId          String   @id
  planId            String
  status            SubStatus @default(TRIALING)
  billingInterval   String   @default("month") // month|year
  provider          String   @default("stripe") // stripe|iyzico
  providerCustomerId String?
  providerSubId     String?
  currentPeriodEnd  DateTime?
  seatsExtra        Int      @default(0)
  workspacesExtra   Int      @default(0)
  trialEndsAt       DateTime?
  // The joined price, kept (TASK-MTR882HVZ8BG7). The pricing page promises the
  // rate a tenant joins at stays theirs; nothing here recorded it, so every
  // quote came from the campaign running now. Written once on activation and on
  // a re-activation after cancellation, never in between — the rule and the
  // reasoning live in src/lib/billing/price-lock.ts. All five are nullable
  // together: a row with none of them is a subscription sold before the lock
  // existed and is priced at the shopfront tier, as it was.
  lockedTierCode    String?   // campaign the rate came from, e.g. ILK5 (provenance)
  lockedPercentOff  Int?      // the rate honoured on renewal, whole percent
  lockedAmountMinor Int?      // what one period cost at that rate, minor units (rule 9)
  lockedCurrency    String?   // currency of lockedAmountMinor
  priceLockedAt     DateTime? // when the rate was locked
  planVersionId     String?  // current plan version (ADIM 2: checkout writes this)
  planVersion       PlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addOns            AddOn[]
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

model AddOn {
  id             String   @id @default(cuid())
  tenantId       String
  sku            String
  quantity       Int      @default(1)
  providerItemId String?
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  subscription   Subscription @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  @@index([tenantId, sku])
}

model LifetimeLicence {          // one-time "first 20 companies" purchase; the pricing page counts these rows
  id                String   @id @default(cuid())
  tenantId          String
  seq               Int      @unique   // which licence of the limited run this is: 1, 2, 3…
  sku               String   @default("lifetime-ultra")
  amountMinor       Int                // what was actually charged, minor units
  currency          String   @default("USD")
  provider          String   @default("stripe")
  providerEventId   String   @unique   // idempotency: one webhook event writes at most one licence
  providerSessionId String?  @unique   // idempotency: one checkout session writes at most one licence
  purchasedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, purchasedAt])
}

model Invoice {                 // an invoice actually issued to a tenant; TASK-MTRD9QBJ2G32E
  id            String   @id @default(cuid())
  tenantId      String
  number        String              // what the customer sees and cites, e.g. "FB-2026-000001"
  issuedAt      DateTime            // UTC, like every other timestamp (CLAUDE.md rule 10)
  currency      String   @default("TRY")
  // VUK 215/280/385 (ADR-0002, option (b)): an invoice denominated in a foreign
  // currency is only valid while it also states the TCMB *buying* rate of its
  // issue date and the Turkish lira equivalent. Those two facts are stored on
  // the row and not merely computed into the XML, so an already-issued document
  // can be reproduced and audited later (CLAUDE.md rule 7).
  //
  // NULL on a TRY invoice: there is nothing to convert. On any other currency a
  // CHECK constraint (`Invoice_fx_required_for_foreign_currency`) refuses the
  // row outright — an invented rate would be an invented figure on a fiscal
  // document, so the invoice is not issued at all rather than issued wrong.
  fxRate             Decimal?  @db.Decimal(18, 6) // TCMB döviz alış kuru: 1 `currency` → TRY
  fxRateDate         DateTime? @db.Date           // publication date of the rate actually used; may precede `issuedAt` across a weekend or public holiday
  fxRateSource       String?                      // where the rate came from, e.g. "TCMB"; never a guess
  grandTotalTryMinor Int?                         // TL karşılığı of the payable grand total, minor units (CLAUDE.md rule 9)
  // The buyer's fiscal identity, frozen at issue time. An invoice must keep
  // saying who it was issued to even after the tenant renames itself or moves,
  // so these are a snapshot on the row and never a join to Tenant.
  buyerName      String
  buyerVknTckn   String             // 10-digit VKN or 11-digit TCKN, as supplied by the buyer
  buyerTaxOffice String
  buyerAddress   String
  buyerCity      String
  buyerCountry   String  @default("Türkiye")
  lines         Json                // InvoiceLine[]; unit prices are minor units (CLAUDE.md rule 9)
  profileId     String   @default("TICARIFATURA")  // TICARIFATURA | TEMELFATURA | EARSIVFATURA
  invoiceType   String   @default("SATIS")         // SATIS | ISTISNA | TEVKIFAT
  ettn          String   @unique    // the document's own UUID, assigned when the row is written
  // Set only once GİB has actually accepted the filing through an integrator.
  // NULL means the document was never filed: the exporter marks it as carrying
  // no fiscal value rather than claiming a fiscal seal it does not have.
  gibEnvelopeId String?
  // The provider payment this invoice was issued for. Unique per tenant, so a
  // redelivered webhook cannot issue a second invoice for one payment; NULL on
  // rows written before the write path existed (TASK-MTSWL8ADKZKDM).
  paymentRef    String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, number])
  @@unique([tenantId, paymentRef])
  @@index([tenantId, issuedAt])
}

/// The buyer's *current* fiscal identity, as the tenant supplied it.
///
/// Nothing else in the schema held this: `Tenant` carries a display name and an
/// ISO country code, and the billing panel used to read the buyer identity back
/// off the newest invoice, which only ever echoes what an earlier invoice
/// already claimed. Without a store, filling `Invoice.buyer*` would mean
/// inventing a taxpayer (TASK-MTSWL8ADKZKDM).
///
/// This row is mutable; `Invoice.buyer*` is the snapshot frozen at issue time.
/// Correcting a typo here never rewrites a document already sent to a customer.
/// A tenant with no row here is not invoiced at all — a SystemAlert names the
/// missing fields instead.
model TenantBillingIdentity {
  tenantId       String   @id
  buyerName      String
  buyerVknTckn   String             // 10-digit VKN or 11-digit TCKN, as supplied by the buyer
  buyerTaxOffice String
  buyerAddress   String
  buyerCity      String
  buyerCountry   String   @default("Türkiye")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id        String   @id @default(cuid())
  tenantId  String
  delta     Int      // + grant, - usage
  reason    String   // monthly_grant | purchase | usage:M2 | refund
  refId     String?
  /// `YYYY-MM` of the scheduled monthly grant (credits-monthly-grant job) and
  /// NULL on every other row. The unique key makes that job one grant per
  /// tenant per month however often it runs (ADR-0008 §6.2, TASK-MUMT3PGX5OK8P).
  grantPeriod String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@unique([tenantId, grantPeriod])
}

// ───────────────────────── K1 Calls (shared, not tenant-scoped) ─────────────────────────

// FO-60 (TASK-MVCH2J271U5VY): platform-wide switches, one row per key. Global,
// like Programme; no tenantId. See prisma/migrations/add-platform-setting.sql.
model PlatformSetting {
  key       String   @id // e.g. "partner_search_ingestion_enabled"
  value     Json
  updatedAt DateTime @updatedAt
}

// FO-389: the shared daily budget of PIC-ownership questions that accounts with no invitation,
// pilot or paid plan may spend between them. One row per UTC day. Global (no tenantId): the
// point is a total that adding accounts cannot raise. See prisma/migrations/add-pic-lookup-budget.sql.
model PicLookupBudget {
  day       String   @id // 'YYYY-MM-DD' (UTC)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Programme {
  id        String @id          // "HE", "DEP", "EUROSTARS", "CETP", "DUT", "ERASMUS", "EIT", "EUREKA", "TUBITAK"
  name      String
  sourceKey String             // adapter key
  calls     Call[]
  funderRules FunderRule[]     // M18 (NG-143): tenant notes about this programme's rules
}

model Call {
  id           String   @id @default(cuid())
  programmeId  String
  callIdentifier String @unique   // e.g. HORIZON-CL5-2026-09
  title        String
  openDate     DateTime?
  budgetCents  BigInt?
  currency     String   @default("EUR")
  url          String?
  programme    Programme @relation(fields: [programmeId], references: [id])
  topics       Topic[]
  // M18 (NG-143): additive, shared with every tenant (no tenantId). The HibeLead call fields
  // FonBridge did not carry (FO-265 §2); no second call table is opened.
  eligibleApplicantTypes String[] @default([])   // applicant-type codes, e.g. "SME", "UNIVERSITY"
  eligibleRegions        String[] @default([])   // NUTS / TR plate codes; empty = no restriction recorded
  cofinancingRateBp      Int?                    // basis points: 7500 = 75 %
  complexity             String?                 // LOW | MEDIUM | HIGH
  leadMatches            LeadMatch[]
  deals                  Deal[]
  leadEligibilityReports LeadEligibilityReport[]
}

model Topic {
  id             String   @id @default(cuid())
  callId         String
  identifier     String   @unique // HORIZON-CL5-2026-09-D4-01
  title          String
  status         TopicStatus @default(FORTHCOMING)
  typeOfAction   String?   // RIA IA CSA ...
  isLumpSum      Boolean  @default(false)
  isTwoStage     Boolean  @default(false)
  budgetPerProjectCents BigInt?
  numProjects    Int?
  deadlines      Json     // [{stage:1, at:"2026-09-15T17:00:00Z", tz:"Europe/Brussels"}]
  nextDeadlineAt DateTime?
  eligibility    Json     @default("{}") // { restricted: "EU_EEA_CH_ONLY" | null, countriesExcluded: [] , notes }
  destination    String?
  keywords       String[]
  description    String?  // expected outcomes + scope (from topicDetails)
  sourceUrl      String?
  rawHash        String?
  embedding      Unsupported("vector(1536)")?
  embeddingHash  String?  // sha256 of the text `embedding` was made from (src/lib/scoring/embeddings.ts)
  fetchedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  call           Call     @relation(fields: [callId], references: [id])
  matches        TopicMatch[]
  stats          TopicStat[]
  partnerAnnouncements PartnerSearchAnnouncement[]
  partnerSearchStat    PartnerSearchTopicStat?
  @@index([nextDeadlineAt])
  @@index([status])
