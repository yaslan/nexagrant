exports[`prompt text is byte-identical to the pre-move inline literals > M6 AI evaluation (prompt + system) 1`] = `
{
  "messages": undefined,
  "prompt": "Perform a rigorous EU Horizon Europe expert evaluation for opportunity cm0opportunity0000000001 based on official REA criteria:
  1. Excellence (0.0 - 5.0): Clarity of objectives, soundness of methodology, open science, gender dimension.
  2. Impact (0.0 - 5.0): Credibility of outcomes/impacts, scale and significance, dissemination & exploitation plan (DEC).
  3. Quality and efficiency of implementation (0.0 - 5.0): Work plan structure, WPs, milestone risk management, consortium capacity.

  Return ONLY valid JSON with keys: excellence (number), impact (number), implementation (number),
  strengths (string[]), weaknesses (string[]), recommendations (string[]).",
  "system": "You are an official European Commission Horizon Europe Proposal Evaluator. Return ONLY valid JSON.",
}
`;

exports[`prompt text is byte-identical to the pre-move inline literals > M6 ESR parser (prompt + system) 1`] = `
{
  "messages": undefined,
  "prompt": "Analyze the following EU Horizon Europe Evaluation Summary Report (ESR) text.
Extract the criteria marks and qualitative comments.

Return ONLY valid JSON with keys:
- excellence: number (0.0 to 5.0)
- impact: number (0.0 to 5.0)
- implementation: number (0.0 to 5.0)
- total: number (0.0 to 15.0)
- threshold: number (default 10.0)
- passed: boolean (true if total >= threshold and all subcriteria >= 3.0)
- strengths: string[]
- weaknesses: string[]

ESR Document Text:
"""
Excellence 4.5
Impact 4.0
Implementation 3.5
"""",
  "system": "You are an EU Horizon Europe ESR document parser. Return ONLY valid JSON.",
}
`;

exports[`prompt text is byte-identical to the pre-move inline literals > M7 IP checklist (prompt + system) 1`] = `
{
  "messages": undefined,
  "prompt": "Generate a university Tech Transfer Office (TTO) IP & Licensing Checklist for:
  Technology Title: Soil sensor array
  Current TRL: TRL 4
  Patent Status: granted

  Include 4 structured checklist categories in Turkish:
  1. Arka Plan Fikri Mülkiyet (Background IP) Beyanı
  2. Ön Plan Fikri Mülkiyet (Foreground IP) ve Lisanslama Stratejisi
  3. Spin-off / Ticari Pazar Açılım Adımları
  4. AB Konsorsiyum Anlaşması (Consortium Agreement) Özel Maddeleri",
  "system": "You are an expert University Technology Transfer Office (TTO) IP legal specialist for EU Horizon Europe.",
}
`;

exports[`prompt text is byte-identical to the pre-move inline literals > M9 meeting brief (prompt + system) 1`] = `
{
  "messages": undefined,
  "prompt": "Generate a 1-page pre-meeting briefing note for a Horizon Europe consortium discussion.
  Partner Name: Fraunhofer IGD
  Call Topic: HORIZON-CL6-2026-01

  Include the following structured sections in Markdown:
  ### 1. Partner Background & EU Track Record
  - Partner profile, PIC overview, EU framework programme experience.
  
  ### 2. Strategic Complementarity for HORIZON-CL6-2026-01
  - Synergies between partner core capabilities and proposal requirements.
  
  ### 3. Suggested Work Package & Role Allocation
  - Recommended Work Package leadership (e.g. WP3 Pilot Demo or WP5 Dissemination) and estimated Person-Months effort.
  
  ### 4. 3 Strategic Questions to Ask in Meeting
  - 3 targeted, high-impact questions to clarify TRL readiness, pilot sites, and effort commitment.
  
  ### 5. Risk Points & Red Flags to Clarify
  - Background IP constraints, competitor overlaps, and budget expectations.",
  "system": "You are an expert EU Horizon Europe coordinator preparing pre-meeting briefs for strategic partners.",
}
`;

exports[`prompt text is byte-identical to the pre-move inline literals > M10 standard document (prompt + system) 1`] = `
{
  "messages": undefined,
  "prompt": "Generate an official, legally structured EU Horizon Europe NDA document for:
  Opportunity: Soil sensing for smart farms
  Document Kind: NDA

  Return structured Markdown text for this document type:
  - If NDA: Mutual Non-Disclosure Agreement clauses, IP confidentiality, 5-year duration.
  - If LOI: Letter of Intent confirming institutional commitment to join the proposal.
  - If COMMITMENT: Consortium Partner Commitment Form specifying Person-Months & Background IP.
  - If ESR_DEBRIEF: Post-evaluation ESR score debrief, strengths, weaknesses & resubmission strategy.
  - If AWARD_PACK: TÜBİTAK Eşik Üstü Ödülü (Threshold Award) package application form & company declaration.",
  "system": "You are an expert EU Horizon Europe legal & administrative document generator.",
}
`;

