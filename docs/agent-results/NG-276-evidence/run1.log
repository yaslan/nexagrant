,\\\"HomePage\\\":{\\\"eyebrow\\\":\\\"Horizon Europe • Digital Europe • Eurostars İçin Uçtan Uca Platform\\\",\\\"heroTitle\\\":\\\"AB Projelerinizi Fikirden Fonlamaya, \\u003caccent\\u003eBaştan Sona Yönetin\\u003c/accent\\u003e\\\",\\\"heroSubtitle\\\":\\\"Çağrı keşfinden CORDIS ortak istihbaratına, yapay zeka destekli konsept notu üretiminden AB hakem simülasyonu ve konsorsiyum masasına kadar tüm aşama-kapı (Stage-Gate) süreçlerini tek platformda birleştirin.\\\",\\\"launchFree\\\":\\\"Ücretsiz Çalışma Alanı Başlatın\\\",\\\"exploreOpenCalls\\\":\\\"Açık Çağrıları İncele\\\",\\\"trustCordis\\\":\\\"CORDIS Ortak İstihbaratı\\\",\\\"trustEvaluator\\\":\\\"AB Hakem Puanlama Simülatörü\\\",\\\"mockProject1\\\":\\\"FLEX-GRID: Decarbonised Smart Grid Flexibility\\\",\\\"mockProject2\\\":\\\"TWIN-HYDRO: AI Digital Twins for Hydrogen\\\",\\\"mockProject3\\\":\\\"CIRC-PACK: Circular Bio Polymers for Packaging\\\",\\\"mockProject4\\\":\\\"CLEAN-PORT: Zero-Emission Coastal Freight\\\",\\\"methodologyLabel\\\":\\\"Metodoloji\\\",\\\"methodologyTitle\\\":\\\"Fikirden Hibe İmzasına: 5 Aşamalı Kapı Modeli\\\",\\\"methodologySubtitle\\\":\\\"Başarısız başvurulara boşa harcanan adam-gün eforunu sonlandırın. Her aşamada matematiksel eşikler ve yapay zeka puanlamasıyla ilerleyin.\\\",\\\"gates\\\":{\\\"g0Title\\\":\\\"Triage \\u0026 Filtre\\\",\\\"g0Desc\\\":\\\"Hedef çağrıya uyum skoru, TRL aralığı ve geçmiş başarı oranına (Base Rate) göre stratejik eleme.\\\",\\\"g1Title\\\":\\\"Konsept Notu\\\",\\\"g1Desc\\\":\\\"Mükemmeliyet (Excellence), Etki (Impact) ve Uygulama mimarisi AB standartlarında yapılandırılır.\\\",\\\"g2Title\\\":\\\"Konsorsiyum\\\",\\\"g2Desc\\\":\\\"CORDIS profillerinden eksik yetkinlik koltukları, koordinatör ve partnerler eşleştirilir.\\\",\\\"g3Title\\\":\\\"Hakem Simülasyonu\\\",\\\"g3Desc\\\":\\\"Teklif metni, bağımsız AB hakemi perspektifiyle 15 puan üzerinden taranır ve zayıf noktalar raporlanır.\\\",\\\"g4Title\\\":\\\"Nihai Teslim\\\",\\\"g4Desc\\\":\\\"Bütçe tabloları, PIC doğrulamaları ve Part A/B dosyaları AB Funding Portal formatında teslimata hazır hale gelir.\\\"},\\\"modulesLabel\\\":\\\"Entegre Modül Mimarisi\\\",\\\"modulesSubtitle\\\":\\\"Teklif yazımından ortak istihbaratına kadar her ihtiyaca özel tasarlanmış modüler araç seti.\\\",\\\"modules\\\":{\\\"m1Name\\\":\\\"CORDIS Ortak İstihbaratı\\\",\\\"m1Desc\\\":\\\"Avrupalı kurumların geçmiş projeleri, aldığı AB hibesi (€) ve ağ merkezilik puanı.\\\",\\\"m2Name\\\":\\\"Konsept Notu Mimarisi\\\",\\\"m2Desc\\\":\\\"Horizon Europe, Eurostars ve ikili çağrılar için kör değerlendirme ve şablonlu konsept üretici.\\\",\\\"m3Name\\\":\\\"Kanıt Paketi Deposu\\\",\\\"m3Desc\\\":\\\"AB politika hedefleri (Green Deal, Digital Decade), etki verileri ve istatistik deposu.\\\",\\\"m4Name\\\":\\\"Focal Point CRM\\\",\\\"m4Desc\\\":\\\"Konsorsiyum ortakları, irtibat kişileri ve 60 günlük soğuma uyarıları ile kurumsal hafıza.\\\",\\\"m5Name\\\":\\\"Aşama-Kapı Boru Hattı\\\",\\\"m5Desc\\\":\\\"G0-G4 Kanban panosu, adam-gün takip aracı ve görev dağıtım takvimi.\\\",\\\"m6Name\\\":\\\"Evaluator Lens (Hakem Simülatörü)\\\",\\\"m6Desc\\\":\\\"Resmi AB hakem kriterleriyle Mükemmeliyet, Etki ve Uygulama bölümlerine yapay zeka denetimi.\\\",\\\"m7Name\\\":\\\"TTO Hızlandırıcısı\\\",\\\"m7Desc\\\":\\\"Üniversite ve araştırma merkezlerinin patent portföyünü AB çağrılarıyla otomatik eşleştirir.\\\",\\\"m8Name\\\":\\\"Konsorsiyum Eşleştirme\\\",\\\"m8Desc\\\":\\\"Coğrafi dağılım, bütçe kısıtları ve rol yetkinliklerine göre en uygun ortak önerileri.\\\",\\\"m11Name\\\":\\\"Tam Başvuru Üreticisi\\\",\\\"m11Desc\\\":\\\"Part A ve Part B başvuru dosyalarını resmi AB formatında tam metin olarak üreten motor.\\\"},\\\"access\\\":\\\"Erişim:\\\",\\\"moduleManifestCta\\\":\\\"Tüm Modül ve Eklenti Detaylarını İncele\\\",\\\"cordisLabel\\\":\\\"Ağ \\u0026 Ortak İstihbaratı\\\",\\\"cordisHeading\\\":\\\"CORDIS Ağ Verisiyle \\u003caccent\\u003eEn Güçlü Konsorsiyumu\\u003c/accent\\u003e Kurun\\