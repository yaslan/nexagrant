# Veritabanı SIRLARI ŞABLONU — yalnız adlar, değer yok.
# Kullanım: sunucuda `cp deploy/vps/.env.db.example deploy/vps/.env.db`, sonra değerleri elle doldur (chmod 600).
# .env.db git'e GİRMEZ (.gitignore: .env*). Bu dosyayı YALNIZ postgres konteyneri ve ops.sh okur;
# web ve worker bu dosyayı almaz (docker-compose.prod.yml). Değer repoya, sohbete, log'a yazılmaz.

# Postgres süper kullanıcısı: fabrika (POSTGRES_USER). Yalnız ilk kurulum (ops.sh bootstrap) ve yedek.
# Tırnaksız yazın (compose tırnağı soyar; ops.sh soymaz — RUNBOOK §2).
POSTGRES_PASSWORD=
# Sahip rol: fabrika_owner (SÜPER KULLANICI DEĞİL; BYPASSRLS). db push, migrasyon, rls, seed, verify için.
# Biçim: postgresql://fabrika_owner:<şifre>@postgres:5432/fabrika?schema=public
# Rolü ops.sh bootstrap oluşturur (deploy/vps/bootstrap-roles.sql). Şifre bu URL'den okunur.
OWNER_DATABASE_URL=
