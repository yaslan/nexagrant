# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# beta onboarding (E11.1) — rendered invitations carry live invitation tokens,
# which grant TENANT_OWNER access; the real roster carries partner PII.
# Both stay out of the repository.
docs/BETA_DATA/generated/
docs/BETA_DATA/beta-partners.local.csv

# one-off codemod scripts and tooling dumps (S8 cleanup)
# Ad-hoc regex patchers written during a typecheck firefight: they rewrite
# source in place (including the `as any` hacks CLAUDE.md forbids) and must
# never be re-run. resolution.log is a 5 MB `tsc --traceResolution` dump.
fix-*.py
patch_schema*.py
resolution.log
*.bak

# Playwright artifacts
test-results/
playwright-report/
.tmp-be-en/
