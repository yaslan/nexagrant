// Fabrika — Prisma schema (MVP scope + v1.1 tables marked)
// Conventions: PascalCase singular models, camelCase fields, tenantId on every tenant-scoped table.
// Money: Int minor units + currency. Timestamps UTC.

generator client {
  provider        = "prisma-client-js"
  output          = "../../node_modules/.prisma/client-mysql-view"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

// ───────────────────────── Tenancy & identity ─────────────────────────

enum TenantKind {
  ORGANIZATION
  AGENCY
}

/// A multi-use code an agency tenant hands out (FB KAMU B1, TASK-MULRQJQYM0NAM).
/// `tenantId` is the AGENCY — named so tenant_isolation covers it unchanged.
/// The code itself is never stored: only its SHA-256 (src/lib/agency/invite-code.ts).
/// Used only through public.redeem_agency_invite(), which increments usedCount
/// atomically and returns the agency id or NULL.
/// No use limit (TASK-MUM4WVYLSH9IT, leed-fb 29.09): a code is governed by
/// expiresAt and revokedAt only. maxUses is a retired column: nullable, never
/// written by new codes, never read. usedCount is an internal counter nobody is shown.
model AgencyInviteCode {
  id        String @db.VarChar(128)    @id @default(cuid())
  tenantId  String @db.VarChar(128)
  codeHash  String    @unique
  codeHint  String @db.LongText
  label     String?
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime
  revokedAt DateTime?
  revokedBy String? @db.LongText
  createdBy String @db.LongText
  createdAt DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@map("v_AgencyInviteCode")
}

enum OrgType {
  SME
  LARGE
  UNIVERSITY
  RESEARCH
  PUBLIC
  NGO
  CONSULTANCY
  CLUSTER
  MUNICIPALITY
}

model Membership {
  id        String @db.VarChar(128)   @id @default(cuid())
  tenantId  String @db.VarChar(128)
  userId    String @db.VarChar(128)
  role      Role     @default(MEMBER)
  workspaceIds Json // empty = all workspaces of tenant
  createdAt DateTime @default(now())
  /// No longer written: the digest's claim moved to `User.staleDigestOn`
  /// (m4-stale-digest-user-claim.sql). Kept for the previous release, which
  /// still claims here; read only so that such a claim made on the deploy day
  /// holds (stale-reminder.ts `legacyClaims`). Dropped in a later file.
  /// m4-stale-reminder-idempotency.sql
  staleDigestOn DateTime? @db.Date
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("v_Membership")
}

enum Role {
  TENANT_OWNER
  TENANT_ADMIN
  PIPELINE_MANAGER
  WRITER
  MEMBER
  GUEST_PARTNER
}

model Workspace {
  id        String @db.VarChar(128)   @id @default(cuid())
  tenantId  String @db.VarChar(128)
  name      String   // e.g. client name for consultancies
  slug      String
  createdAt DateTime @default(now())
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String? @db.LongText
  opportunities Opportunity[]
  @@unique([tenantId, slug])
  @@index([deletedAt])
  @@map("v_Workspace")
}

model TenantProfile {
  tenantId      String @db.VarChar(128)   @id
  capabilities  String @db.LongText   // free text, used for embedding
  keywords      Json
  naceCodes     Json
  trlRange      Json    // [min,max]
  preferredRoles Json // coordinator, tech_provider, pilot_site, dissemination...
  priorProjects Json     @default("[]")
  embedding     Json?
  embeddingHash String? @db.LongText  // sha256 of the text `embedding` was made from (src/lib/scoring/embeddings.ts)
  updatedAt     DateTime @updatedAt
  @@map("v_TenantProfile")
}

// ───────────────────────── Modules & entitlements ─────────────────────────

enum ModuleStatus {
  OFF
  DEV
  PILOT
  ON
}

model ModuleState {
  id        String @db.VarChar(128)       @id @default(cuid())
  tenantId  String @db.VarChar(128)
  moduleId  String
  status    ModuleStatus @default(OFF)
  settings  Json         @default("{}")
  changedBy String? @db.LongText
  changedAt DateTime     @default(now())
  // FO-41: keeps the module entitled whatever the plan (M3 for pre-FO-41
  // Discover tenants). Set by migrations only; a trigger refuses fabrika_app.
  // Migration: module-state-grandfathered.sql.
  grandfathered Boolean  @default(false)
  @@unique([tenantId, moduleId])
  @@map("v_ModuleState")
}

model Plan {                    // projection of src/lib/billing/catalog.ts; seeded: free, basic, pro, ultra
  id            String @db.VarChar(64)  @id    // "pro"
  name          String
  monthlyCents  Int            // list price, minor units — the campaign discount lives at checkout
  yearlyCents   Int
  currency      String  @default("USD")
  seats         Int
  workspaces    Int
  aiCreditsMonthly Int
  modules       Json       // default ON modules
  stripePriceMonthly String? @db.LongText
  stripePriceYearly  String? @db.LongText
  visibility    String @db.LongText  @default("public") // public | private | archived
  versions      PlanVersion[]
  assignments   PlanAssignment[]
  @@map("v_Plan")
}

// Plan* and Subscription.planVersion FKs: onUpdate NoAction mirrors
// add-plan-versioning/migration.sql, which declares no ON UPDATE clause.
model PlanVersion {
  id            String @db.VarChar(128)  @id    @default(cuid())
  planId        String @db.VarChar(64)
  plan          Plan    @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  version       Int             // semantic version: 1, 2, 3, ...
  status        String  @default("draft") // draft | published | archived
  monthlyCents  Int
  yearlyCents   Int
  currency      String  @default("USD")
  seats         Int
  workspaces    Int
  aiCreditsMonthly Int
  modules       Json @default("[]") // modules granted by this version
  features      PlanFeature[]
  publishedBy   String? @db.LongText        // user id who published this version
  publishedAt   DateTime?      // when this version was published (immutable after)
  subscriptions Subscription[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([planId, version])
  @@map("v_PlanVersion")
}

model PlanFeature {
  id            String @db.VarChar(128)  @id    @default(cuid())
  planVersionId String @db.VarChar(128)
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order         Int             // display order (1, 2, 3, ...)
  kind          String          // module | limit | text
  moduleId      String?         // if kind='module': module identifier (M1, M8, etc)
  limitKey      String? @db.LongText         // if kind='limit': limit identifier (e.g. "seats", "credits")
  textTr        String? @db.LongText         // if kind='text': Turkish label or description
  textEn        String? @db.LongText         // if kind='text': English label or description
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([planVersionId, order])
  @@map("v_PlanFeature")
}

model PlanAssignment {
  id            String @db.VarChar(128)  @id    @default(cuid())
  planId        String @db.VarChar(64)
  plan          Plan    @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tenantId      String @db.VarChar(128)
  assignedBy    String? @db.LongText        // user id who made the assignment
  assignedAt    DateTime @default(now())
  note          String?        // reason or memo
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([planId, tenantId])
  @@map("v_PlanAssignment")
}

model Subscription {
  tenantId          String @db.VarChar(128)   @id
  planId            String
  status            SubStatus @default(TRIALING)
  billingInterval   String @db.LongText   @default("month") // month|year
  provider          String @db.LongText   @default("stripe") // stripe|iyzico
  providerCustomerId String? @db.LongText
  providerSubId     String? @db.LongText
  currentPeriodEnd  DateTime?
  seatsExtra        Int      @default(0)
  workspacesExtra   Int      @default(0)
  trialEndsAt       DateTime?
  // The joined price, kept (TASK-MTR882HVZ8BG7). The pricing page promises the
  // rate a tenant joins at stays theirs; nothing here recorded it, so every
  // quote came from the campaign running now. Written once on activation and on
  // a re-activation after cancellation, never in between — the rule and the
  // reasoning live in src/lib/billing/price-lock.ts. All five are nullable
  // together: a row with none of them is a subscription sold before the lock
  // existed and is priced at the shopfront tier, as it was.
  lockedTierCode    String? @db.LongText   // campaign the rate came from, e.g. ILK5 (provenance)
  lockedPercentOff  Int?      // the rate honoured on renewal, whole percent
  lockedAmountMinor Int?      // what one period cost at that rate, minor units (rule 9)
  lockedCurrency    String? @db.LongText   // currency of lockedAmountMinor
  priceLockedAt     DateTime? // when the rate was locked
  planVersionId     String? @db.VarChar(128)  // current plan version (ADIM 2: checkout writes this)
  planVersion       PlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  addOns            AddOn[]
  @@map("v_Subscription")
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

model AddOn {
  id             String @db.VarChar(128)   @id @default(cuid())
  tenantId       String @db.VarChar(128)
  sku            String
  quantity       Int      @default(1)
  providerItemId String? @db.LongText
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  subscription   Subscription @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  @@index([tenantId, sku])
  @@map("v_AddOn")
}

model LifetimeLicence {          // one-time "first 20 companies" purchase; the pricing page counts these rows
  id                String @db.VarChar(128)   @id @default(cuid())
  tenantId          String @db.VarChar(128)
  seq               Int      @unique   // which licence of the limited run this is: 1, 2, 3…
  sku               String   @default("lifetime-ultra")
  amountMinor       Int                // what was actually charged, minor units
  currency          String   @default("USD")
  provider          String @db.LongText   @default("stripe")
  providerEventId   String   @unique   // idempotency: one webhook event writes at most one licence
  providerSessionId String?  @unique   // idempotency: one checkout session writes at most one licence
  purchasedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  @@index([tenantId, purchasedAt])
  @@map("v_LifetimeLicence")
}

model Invoice {                 // an invoice actually issued to a tenant; TASK-MTRD9QBJ2G32E
  id            String @db.VarChar(128)   @id @default(cuid())
  tenantId      String @db.VarChar(128)
  number        String              // what the customer sees and cites, e.g. "FB-2026-000001"
  issuedAt      DateTime            // UTC, like every other timestamp (CLAUDE.md rule 10)
  currency      String   @default("TRY")
  // VUK 215/280/385 (ADR-0002, option (b)): an invoice denominated in a foreign
  // currency is only valid while it also states the TCMB *buying* rate of its
  // issue date and the Turkish lira equivalent. Those two facts are stored on
  // the row and not merely computed into the XML, so an already-issued document
  // can be reproduced and audited later (CLAUDE.md rule 7).
  //
  // NULL on a TRY invoice: there is nothing to convert. On any other currency a
  // CHECK constraint (`Invoice_fx_required_for_foreign_currency`) refuses the
  // row outright — an invented rate would be an invented figure on a fiscal
  // document, so the invoice is not issued at all rather than issued wrong.
  fxRate             Decimal?  @db.Decimal(18, 6) // TCMB döviz alış kuru: 1 `currency` → TRY
  fxRateDate         DateTime? @db.Date           // publication date of the rate actually used; may precede `issuedAt` across a weekend or public holiday
  fxRateSource       String? @db.LongText                      // where the rate came from, e.g. "TCMB"; never a guess
  grandTotalTryMinor Int?                         // TL karşılığı of the payable grand total, minor units (CLAUDE.md rule 9)
  // The buyer's fiscal identity, frozen at issue time. An invoice must keep
  // saying who it was issued to even after the tenant renames itself or moves,
  // so these are a snapshot on the row and never a join to Tenant.
  buyerName      String @db.LongText
  buyerVknTckn   String @db.LongText             // 10-digit VKN or 11-digit TCKN, as supplied by the buyer
  buyerTaxOffice String @db.LongText
  buyerAddress   String @db.LongText
  buyerCity      String @db.LongText
  buyerCountry   String @db.LongText  @default("Türkiye")
  lines         Json                // InvoiceLine[]; unit prices are minor units (CLAUDE.md rule 9)
  profileId     String @db.LongText   @default("TICARIFATURA")  // TICARIFATURA | TEMELFATURA | EARSIVFATURA
  invoiceType   String @db.LongText   @default("SATIS")         // SATIS | ISTISNA | TEVKIFAT
  ettn          String   @unique    // the document's own UUID, assigned when the row is written
  // Set only once GİB has actually accepted the filing through an integrator.
  // NULL means the document was never filed: the exporter marks it as carrying
  // no fiscal value rather than claiming a fiscal seal it does not have.
  gibEnvelopeId String?
  // The provider payment this invoice was issued for. Unique per tenant, so a
  // redelivered webhook cannot issue a second invoice for one payment; NULL on
  // rows written before the write path existed (TASK-MTSWL8ADKZKDM).
  paymentRef    String?
  createdAt     DateTime @default(now())
  @@unique([tenantId, number])
  @@unique([tenantId, paymentRef])
  @@index([tenantId, issuedAt])
  @@map("v_Invoice")
}

/// The buyer's *current* fiscal identity, as the tenant supplied it.
///
/// Nothing else in the schema held this: `Tenant` carries a display name and an
/// ISO country code, and the billing panel used to read the buyer identity back
/// off the newest invoice, which only ever echoes what an earlier invoice
/// already claimed. Without a store, filling `Invoice.buyer*` would mean
/// inventing a taxpayer (TASK-MTSWL8ADKZKDM).
///
/// This row is mutable; `Invoice.buyer*` is the snapshot frozen at issue time.
/// Correcting a typo here never rewrites a document already sent to a customer.
/// A tenant with no row here is not invoiced at all — a SystemAlert names the
/// missing fields instead.
model TenantBillingIdentity {
  tenantId       String @db.VarChar(128)   @id
  buyerName      String @db.LongText
  buyerVknTckn   String @db.LongText             // 10-digit VKN or 11-digit TCKN, as supplied by the buyer
  buyerTaxOffice String @db.LongText
  buyerAddress   String @db.LongText
  buyerCity      String @db.LongText
  buyerCountry   String @db.LongText   @default("Türkiye")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  @@map("v_TenantBillingIdentity")
}

model CreditLedger {
  id        String @db.VarChar(128)   @id @default(cuid())
  tenantId  String @db.VarChar(128)
  delta     Int      // + grant, - usage
  reason    String   // monthly_grant | purchase | usage:M2 | refund
  refId     String? @db.LongText
  /// `YYYY-MM` of the scheduled monthly grant (credits-monthly-grant job) and
  /// NULL on every other row. The unique key makes that job one grant per
  /// tenant per month however often it runs (ADR-0008 §6.2, TASK-MUMT3PGX5OK8P).
  grantPeriod String?
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
  @@unique([tenantId, grantPeriod])
  @@map("v_CreditLedger")
}

// ───────────────────────── K1 Calls (shared, not tenant-scoped) ─────────────────────────

// FO-60 (TASK-MVCH2J271U5VY): platform-wide switches, one row per key. Global,
// like Programme; no tenantId. See prisma/migrations/add-platform-setting.sql.
enum TopicStatus {
  FORTHCOMING
  OPEN
  CLOSED
}

model TopicMatch {
  id        String @db.VarChar(128)   @id @default(cuid())
  tenantId  String @db.VarChar(128)
  topicId   String @db.VarChar(128)
  /// The opportunity this G0 evidence belongs to; NULL on a topic-level K1 match row.
  opportunityId String? @db.VarChar(128)
  fitScore  Float    // 0..100
  g0Score   Float?   // weighted total
  breakdown Json     // per-criterion
  computedAt DateTime @default(now())
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([tenantId, topicId, opportunityId])
  @@index([tenantId, g0Score])
  @@index([tenantId, opportunityId])
  @@map("v_TopicMatch")
}

model SavedSearch {
  id        String @db.VarChar(128)   @id @default(cuid())
  tenantId  String @db.VarChar(128)
  userId    String @db.LongText
  name      String
  filters   Json
  notify    Boolean  @default(true)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  @@index([tenantId])
  @@map("v_SavedSearch")
}

// ───────────────────────── K2 CORDIS & M1 Derived Tables (shared) ─────────────────────────

enum PartnerSearchAnnouncementType {
  EXPERTISE_REQUEST
  EXPERTISE_OFFER
}

enum PartnerSearchOrgType {
  HES
  REC
  PRC
  PUB
  OTH
}

enum PartnerSearchSource {
  PORTAL_API
  TOPIC_HTML
}

enum PartnerSearchRunTrigger {
  FULL
  INCREMENTAL
  MANUAL
}

enum PartnerSearchRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model PartnerSearchQuotaUsage {
  id        String @db.VarChar(128)   @id @default(cuid())
  tenantId  String @db.VarChar(128)
  month     String   // 'YYYY-MM' (UTC)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, month])
  @@map("v_PartnerSearchQuotaUsage")
}

// ───────────────────────── K5 Pipeline (tenant-scoped) ─────────────────────────

model Opportunity {
  id           String @db.VarChar(128)   @id @default(cuid())
  tenantId     String @db.VarChar(128)
  workspaceId  String @db.VarChar(128)
  topicId      String? @db.LongText
  title        String
  stage        Gate     @default(G0)
  status       OppStatus @default(ACTIVE)
  intendedRole String? @db.LongText  // coordinator | partner
  ownerId      String? @db.LongText
  g0Score      Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String? @db.LongText
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proposal     Proposal?
  gateDecisions GateDecision[]
  seats        ConsortiumSeat[]
  efforts      Effort[]
  topicMatches TopicMatch[]
  @@index([tenantId, workspaceId, stage])
  followupDocs FollowupDoc[]
  applicationParts ApplicationPart[]
  evaluations Evaluation[]
  meetingBriefs MeetingBrief[]
  @@index([deletedAt])
  @@map("v_Opportunity")
}

enum Gate {
  G0
  G1
  G2
  G3
  G4
}
enum OppStatus {
  ACTIVE
  WITHDRAWN
  SUBMITTED
  FUNDED
  REJECTED
  ABOVE_THRESHOLD
}

model GateDecision {
  id            String @db.VarChar(128)   @id @default(cuid())
  tenantId      String @db.VarChar(128)
  opportunityId String @db.VarChar(128)
  gate          Gate
  passed        Boolean
  inputs        Json     // values evaluated
  ruleVersion   String @db.LongText
  decidedBy     String @db.LongText
  decidedAt     DateTime @default(now())
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String? @db.LongText
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@index([tenantId, opportunityId])
  @@index([deletedAt])
  @@map("v_GateDecision")
}

model ConsortiumSeat {
  id            String @db.VarChar(128)   @id @default(cuid())
  tenantId      String @db.VarChar(128)
  opportunityId String @db.VarChar(128)
  roleKey       String @db.LongText   // coordinator | research | industry | end_user | widening | dissemination | custom
  required      Boolean  @default(true)
  organizationId String? // filled seat (CORDIS PIC) or
  partnerOrgId  String?  // tenant-private partner record
  status        SeatStatus @default(OPEN)
  budgetCents   BigInt?
  personMonths  Float?
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@index([tenantId, opportunityId])
  @@map("v_ConsortiumSeat")
}

enum SeatStatus {
  OPEN
  CANDIDATE
  INVITED
  CONFIRMED
  DECLINED
}

model PartnerOrg {                 // tenant-private orgs not in CORDIS
  id        String @db.VarChar(128)  @id @default(cuid())
  tenantId  String @db.VarChar(128)
  name      String
  country   String? @db.LongText
  orgType   String? @db.LongText
  pic       String?
  website   String?
  createdAt DateTime @default(now())
  @@index([tenantId])
  @@map("v_PartnerOrg")
}

model Proposal {
  id            String @db.VarChar(128)   @id @default(cuid())
  tenantId      String @db.VarChar(128)
  opportunityId String @db.VarChar(128)   @unique
  acronym       String?
  submittedAt   DateTime?
  esrScores     Json?    // {excellence, impact, implementation, total, threshold}
  esrFileUrl    String? @db.LongText
  outcome       String?  // funded | reserve | above_threshold | below
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String? @db.LongText
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  evaluations   Evaluation[]
  @@index([deletedAt])
  @@map("v_Proposal")
}

model Effort {
  id            String @db.VarChar(128)   @id @default(cuid())
  tenantId      String @db.VarChar(128)
  opportunityId String @db.VarChar(128)
  userId        String @db.LongText
  date          DateTime
  hours         Float
  note          String?
  deletedAt      DateTime?  // soft-delete marker (KVKK/GDPR erasure)
  deletionReason String? @db.LongText
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@index([tenantId, opportunityId])
  @@index([deletedAt])
  @@map("v_Effort")
}

// ───────────────────────── M3 Evidence Pack ─────────────────────────

model Evidence {
  id                 String @db.VarChar(128)               @id @default(cuid())
  tenantId           String @db.VarChar(128)
  kind               String               // corporate | financial | certificate | infrastructure | performance | ethics | partner | personnel
  category           String               @default("certificate") // CAT-01 .. CAT-08
  title              String
  body               String               @db.LongText
  description        String?              @db.LongText
  language           String @db.LongText               @default("tr") // tr | en | bilingual
  issuingAuthority   String? @db.LongText              // TSE, İTO, TÜRKAK, Audit Firm
  documentNumber     String? @db.LongText              // Certificate / Doc No
  issuedAt           DateTime?
  validFrom          DateTime?
  validUntil         DateTime?
  confidentiality    String @db.LongText               @default("INTERNAL") // PUBLIC | CONSORTIUM | INTERNAL | RESTRICTED
  status             String               @default("VALID") // UNVERIFIED | VALID | EXPIRING_SOON | EXPIRED | REJECTED
  version            Int                  @default(1)
  
  // Cloudflare R2 Depolama Bilgileri
  r2ObjectKey        String?              // tenantId/orgId/cat/hash.ext
  fileBucket         String @db.LongText               @default("fonbridge-evidence")
  fileName           String?
  fileSizeBytes      Int?
  mimeType           String? @db.LongText
  checksumSha256     String? @db.LongText
  fileUrl            String? @db.LongText
  sourceUrl          String? @db.LongText
  sourceDate         DateTime?

  // YZ & OCR Metadata
  ocrText            String?              @db.LongText
  extractedFields    Json                 @default("{}")
  tags               Json
  lastUsedIn         String? @db.LongText              // proposalId
  createdBy          String @db.LongText               @default("system")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  claimLinks         ClaimEvidenceLink[]
  proposalUsages     ProposalUsage[]

  // One row per stored object (D-3, TASK-MUNTTZ94LJWBC): confirming the same
  // key twice made two rows, and deleting either removed the other's file.
  // prisma/migrations/evidence-unique-object-key.sql
  @@unique([tenantId, r2ObjectKey])
  @@index([tenantId, kind])
  @@index([tenantId, category])
