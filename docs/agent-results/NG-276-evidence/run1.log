k\\\",\\\"titleSlug\\\":\\\"Başlık \\u0026 Slug\\\",\\\"category\\\":\\\"Kategori\\\",\\\"author\\\":\\\"Yazar\\\",\\\"published\\\":\\\"Yayın Tarihi\\\",\\\"featured\\\":\\\"Öne Çıkan (Ana Sayfa)\\\",\\\"actions\\\":\\\"İşlemler\\\",\\\"empty\\\":\\\"Herhangi bir blog yazısı bulunamadı.\\\",\\\"featuredOn\\\":\\\"Ana sayfada gösteriliyor (Öne çıkan)\\\",\\\"featuredOff\\\":\\\"Ana sayfaya ekle\\\",\\\"preview\\\":\\\"Ön izle\\\",\\\"edit\\\":\\\"Düzenle\\\",\\\"delete\\\":\\\"Sil\\\"},\\\"modal\\\":{\\\"editTitle\\\":\\\"Blog Yazısını Düzenle\\\",\\\"createTitle\\\":\\\"Yeni Blog Yazısı Oluştur\\\",\\\"titleLabel\\\":\\\"Makale Başlığı *\\\",\\\"titlePlaceholder\\\":\\\"örn: Horizon Europe Konsorsiyum Kurma Rehberi\\\",\\\"categoryLabel\\\":\\\"Kategori *\\\",\\\"categoryPlaceholder\\\":\\\"örn: Horizon Europe\\\",\\\"excerptLabel\\\":\\\"Özet (Excerpt) *\\\",\\\"excerptPlaceholder\\\":\\\"Kartta görünecek kısa açıklama metni...\\\",\\\"authorName\\\":\\\"Yazar Adı\\\",\\\"authorRole\\\":\\\"Yazar Unvanı\\\",\\\"featuredCheckbox\\\":\\\"Ana sayfadaki 3'lü Öne Çıkan Blog Alanında Göster (Featured)\\\",\\\"cancel\\\":\\\"İptal\\\",\\\"saving\\\":\\\"Kaydediliyor...\\\",\\\"saveChanges\\\":\\\"Değişiklikleri Kaydet\\\",\\\"publish\\\":\\\"Yayınla\\\"}},\\\"adminDocuments\\\":{\\\"title\\\":\\\"Belgeler (K6 RAG)\\\",\\\"subtitle\\\":\\\"Çalışma programı ve konu PDF'lerini paylaşılan RAG belleğine yükleyin. Metin parçalara ayrılır, her parça OpenAI ile gömülür (maliyet platforma yazılır) ve tüm kiracıların aramasında kullanılır.\\\",\\\"uploadHeading\\\":\\\"PDF yükle\\\",\\\"fileLabel\\\":\\\"PDF dosyası\\\",\\\"fileHint\\\":\\\"Yalnızca metin katmanı olan PDF, en fazla {maxMb} MB. Taranmış (yalnız görüntü) PDF kabul edilmez.\\\",\\\"kindLabel\\\":\\\"Belge türü\\\",\\\"titleLabel\\\":\\\"Başlık\\\",\\\"uploadButton\\\":\\\"Yükle ve göm\\\",\\\"working\\\":\\\"Yükleniyor…\\\",\\\"workingDetail\\\":\\\"PDF ayrıştırılıyor ve parçalar gömülüyor. Büyük bir çalışma programı