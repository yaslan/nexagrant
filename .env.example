# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_LOCALE=tr

# --- Database (Postgres 16 + pgvector) ---
DATABASE_URL=postgresql://fabrika:fabrika@localhost:5432/fabrika
DATABASE_URL_MIGRATE=postgresql://fabrika_migrate:fabrika@localhost:5432/fabrika
# RLS-subject role (NOSUPERUSER, NOBYPASSRLS). Created by `pnpm db:rls-role`, which
# generates the password and appends the real value to .env. Used only by
# tests/rls.spec.ts — the app itself still connects as DATABASE_URL.
DATABASE_URL_RLS_TEST=postgresql://fabrika_app:generated-by-pnpm-db-rls-role@localhost:5432/fabrika

# --- Auth.js ---
# Required: the server refuses to start without it. Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Password-less e-mail and one-click demo sign-in (src/lib/demo-login.ts).
# `true` = anyone who types an address signs in as that account, an unknown address
# creates one, and admin@yasinaslan.com.tr is a platform admin. Local/demo only.
# Unset or `false` = off: only the OAuth providers above, platform admin only from
# the database. With NODE_ENV=production the server REFUSES TO START while it is `true`.
DEMO_LOGIN_ENABLED=true

# --- Jobs (Inngest) ---
INNGEST_API_KEY=
INNGEST_SIGNING_KEY=
REDIS_URL=redis://localhost:6379

# --- Python worker ---
WORKER_URL=http://localhost:8000
WORKER_TOKEN=change-me

# --- AI ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536

# --- External data ---
SEDIA_SEARCH_URL=https://api.tech.ec.europa.eu/search-api/prod/rest/search
SEDIA_API_KEY=SEDIA
SEDIA_TOPIC_DETAILS_URL=https://ec.europa.eu/info/funding-tenders/opportunities/data/topicDetails
CORDIS_HE_ZIP_URL=https://cordis.europa.eu/data/cordis-HORIZONprojects-csv.zip
CORDIS_H2020_ZIP_URL=https://cordis.europa.eu/data/cordis-h2020projects-csv.zip
APIFY_TOKEN=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# iyzico (TRY billing). Leave blank to keep the flow disabled — the webhook
# route then rejects every delivery instead of accepting unverifiable ones.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox by default; set to https://api.iyzipay.com only for live billing.
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Storage / email / observability ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fabrika
RESEND_API_KEY=
EMAIL_FROM="Fabrika <no-reply@example.com>"
# Weekly beta feedback digest recipient. Unset = the digest is computed but not sent.
FEEDBACK_DIGEST_TO=
NEXT_PUBLIC_POSTHOG_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Calendar Integration ---
# 256-bit AES-GCM key for CalendarConnection token encryption. Generate: openssl rand -base64 32
# Changing it makes existing encrypted tokens unreadable (users reconnect their calendar).
CALENDAR_ENCRYPTION_KEY=

# --- TCMB exchange rates (ADR-0002) ---
# A foreign-currency invoice must state the TCMB forex buying rate of its issue
# date and the TL equivalent (VUK 215/280/385). The bulletin is public and needs
# no credential, so leave this blank in every real environment; it exists only so
# a test can point at a fixture host. There is no fallback rate: if TCMB cannot
# be read, no invoice is issued and a SystemAlert is raised.
TCMB_BASE_URL=

# --- e-Fatura: satıcı kimliği (INVOICE_SUPPLIER_*) ---
# Faturanın "kimden" bilgisi. Beşi (NAME, VKN, TAX_OFFICE, ADDRESS, CITY) eksikse
# fatura satırı yazılır ama BELGE üretilmez: /api/billing/invoices/<no>/export
# 503 supplier_identity_not_configured döner (eksik değişkenlerin adıyla).
# DİKKAT: buradaki ad TÜZEL KİŞİ UNVANIDIR (FonBridge Ltd. Şti.), ürün adı değil
# (ürün: Fabrika). Emekli ürün adını temizleyen bir tarama bu değeri DEĞİŞTİRMEZ.
INVOICE_SUPPLIER_NAME=
INVOICE_SUPPLIER_VKN=
INVOICE_SUPPLIER_TAX_OFFICE=
INVOICE_SUPPLIER_ADDRESS=
INVOICE_SUPPLIER_CITY=
INVOICE_SUPPLIER_COUNTRY=
INVOICE_SUPPLIER_EMAIL=

# --- e-Fatura: KDV ---
# KDV için AYARLANACAK BİR DEĞİŞKEN YOKTUR. Oran 2026-09-08'den beri ALICININ
# ÜLKESİNDEN gelir (src/lib/billing/vat-rates.ts — ülke + oran + kaynak +
# yürürlük tarihi). Patron kararı 2026-09-08: fiyatlar KDV HARİÇ ilan edilir;
# Türkiye %20, Kuveyt %0. Kaynaklı satırı olmayan ülkeye fatura KESİLMEZ
# (SystemAlert üretilir) — tahmin yok. Oran değişecekse tabloya kaynaklı bir
# satır eklenir. (INVOICE_VAT_RATE 2026-09-09'da kaldırıldı — TASK-MTTTMECDO7RC8.)

# --- e-Fatura: özel entegratör (EFATURA_INTEGRATOR_*) ---
# Belgeyi GİB'e ileten lisanslı aracı. Dördü (PROVIDER, BASE_URL, USERNAME,
# PASSWORD) dolmadan gönderim denenmez. UYARI: bunlar dolu olsa BİLE gönderim
# çalışmaz — ADAPTERS (src/lib/efatura-integrator.ts) bugün yalnız `sandbox`
# içeriyor; seçilen satıcıya özel adaptör yazılana kadar sonuç
# `provider_unsupported` döner ve asla "gönderildi" denmez.
# PASSWORD repoya YAZILMAZ, sır yöneticisine girilir.
EFATURA_INTEGRATOR_PROVIDER=
EFATURA_INTEGRATOR_BASE_URL=
EFATURA_INTEGRATOR_USERNAME=
EFATURA_INTEGRATOR_PASSWORD=
EFATURA_INTEGRATOR_TEST_MODE=true
