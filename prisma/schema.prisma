// ───────────────────── Partner Search (FO-58, global + one tenant counter) ─────────────────────
// Funding & Tenders Portal partner-search announcements (docs/agent-results/TASK-MVCGPI6V3RM1F-*).
// Global reference data like CORDIS: no tenantId, SYSTEM_WIDE in scripts/rls-models.ts.
// Person announcements are NEVER stored as rows; only PartnerSearchTopicStat counts them.
// Migration: prisma/migrations/add-partner-search.sql

enum PartnerSearchAnnouncementType {
  EXPERTISE_REQUEST
  EXPERTISE_OFFER
}

enum PartnerSearchOrgType {
  HES
  REC
  PRC
  PUB
  OTH
}

enum PartnerSearchSource {
  PORTAL_API
  TOPIC_HTML
}

enum PartnerSearchRunTrigger {
  FULL
  INCREMENTAL
  MANUAL
}

enum PartnerSearchRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model PartnerSearchAnnouncement {
  id               String                        @id @default(cuid())
  externalId       String                        @unique // portal announcement key
  topicIdentifier  String                        // Topic.identifier
  callIdentifier   String?
  type             PartnerSearchAnnouncementType
  description      String?                       @db.VarChar(500)
  publishedAt      DateTime?
  lastSeenAt       DateTime
  withdrawnAt      DateTime?
  missedScans      Int                           @default(0) // consecutive scans without this row; 2 → withdrawn
  missedScanAt     DateTime?                     // UTC day of the last counted miss: one miss per day (FO-60 review 2)
  organizationPic  String?                       // CordisOrganization.organisationId when matched
  organizationName String
  organizationType PartnerSearchOrgType          @default(OTH)
  isSme            Boolean                       @default(false)
  country          String?                       // ISO-3166-1 alpha-2
  city             String?
  keywords         Json                          @default("[]") // string[]
  programmeCodes   Json                          @default("[]") // string[]
  source           PartnerSearchSource
  raw              Json?                         // allowlisted fields only; ecasId NEVER
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  topic            Topic                         @relation(fields: [topicIdentifier], references: [identifier], onDelete: Cascade)

  @@index([topicIdentifier])
  @@index([organizationPic])
  @@index([country])
  @@index([type])
  @@index([lastSeenAt])
}

// Latest portal organisation profile per PIC (overwritten on each fetch).
model PartnerProfileSnapshot {
  pic               String   @id
  name              String
  type              PartnerSearchOrgType @default(OTH)
  country           String?
  city              String?
  description       String?  @db.Text
  keywords          Json     @default("[]") // string[]
  projectCount      Int      @default(0)
  announcementCount Int      @default(0)
  programmes        Json     @default("[]") // [{ code, role }]
  topCollaborators  Json     @default("[]") // [{ pic, name, sharedProjects }]
  fetchedAt         DateTime @default(now())

  @@index([country])
}

model PartnerSearchIngestionRun {
  id                      String                  @id @default(cuid())
  startedAt               DateTime                @default(now())
  finishedAt              DateTime?
  trigger                 PartnerSearchRunTrigger
  topicsScanned           Int                     @default(0)
  created                 Int                     @default(0)
  updated                 Int                     @default(0)
