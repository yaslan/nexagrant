# Canlı ortam değişkenleri ŞABLONU — adlar + yalnız GENEL (gizli olmayan) adres değerleri
# (alan adı, SMTP sunucu adı, gönderen adresi). Parola/anahtar/token değeri YOK. Web ve worker'ın gördüğü dosya.
# Süper kullanıcı ve sahip rol sırları AYRI dosyada: deploy/vps/.env.db.example (FO-301 Y-5).
# Kullanım: sunucuda `cp deploy/vps/.env.prod.example deploy/vps/.env.prod`, sonra
# değerleri sunucuda elle doldur (chmod 600). .env.prod git'e GİRMEZ (.gitignore: .env*).
# Değerleri repoya, sohbete, log'a yazma. Ad listesi: src/lib/env.ts + docs/RELEASE_CHECKLIST.md §2.
# Pilotta BOŞ kalmalı (ADR-0007): STRIPE_*, IYZICO_*, BILLING_ACTIVE_TIER, EFATURA_INTEGRATOR_*, INVOICE_SUPPLIER_*.
# Bu dosyada olmayan (kullanılmayan) ad: REDIS_URL, UPSTASH_*, GOOGLE_CLIENT_* (eski adlar).

# --- Uygulama (zorunlu) ---
NODE_ENV=
# Canlıda: https://nexagrant.com (kanonik). Yanlışsa davet ve e-posta bağlantıları bozulur.
NEXT_PUBLIC_APP_URL=https://nexagrant.com
# Auth.js çağrı adresi; NEXT_PUBLIC_APP_URL ile aynı olmalı (src/lib/public-url.ts).
AUTH_URL=https://nexagrant.com
NEXT_PUBLIC_APP_VERSION=
DEFAULT_LOCALE=
# Yalnız web ve worker içinde kullanılır; sunucu başlamadan AUTH_SECRET >= 32 karakter olmalı.
AUTH_SECRET=
NEXTAUTH_SECRET=
# Google OAuth (yeni fonbridges GCP istemcisi). Yönlendirme URI'si: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Uygulamanın önündeki güvenilir ters vekil sayısı (src/lib/leads/public-lead.ts clientIpFrom).
# Varsayılan 1: yalnız CloudPanel nginx. Nginx ile web arasına Varnish girerse 3 (RUNBOOK §5.1 madde 3a).
# Değer canlıda ölçümle doğrulanır; tahmin edilip yazılmaz. Boş bırakma.
TRUSTED_PROXY_HOPS=1
# Canlıda ALERTS_OPS_EMAIL ve PIC_REGISTRY_* adları src/lib/env.ts'te; değerleri sunucuda elle girilir.
ALERTS_OPS_EMAIL=
PIC_REGISTRY_URL=
PIC_REGISTRY_OFF=
LEAD_TRANSFER_CONSENT_ENABLED=
# NOT: WEB_HOST_PORT buraya YAZILMAZ. Compose yalnız interpolasyon için deploy/vps/.env okur; .env.prod'daki değer
# portu değiştirmez (NG-261 O-1). Port için RUNBOOK §2 "WEB_HOST_PORT" maddesi.
# Üretimde yalnız boş ya da false. true ise sunucu başlamaz.
DEMO_LOGIN_ENABLED=

# --- Veritabanı (uygulama rolleri; sahip ve süper kullanıcı sırları .env.db.example'da) ---
# Parolalar URL'e girer: `openssl rand -hex 32` (yalnız hex; base64 içindeki / + = URL'yi bozar).
# Uygulama rolü: fabrika_app (BYPASSRLS YOK). Sunucu adı: compose servis adı `postgres`.
# Biçim (DB-1, Supabase; postgres servisi bu yığında kalkmaz). <supabase-host> ve <veritabani> YER TUTUCU:
# canlı veritabanının Supabase projesi, bölgesi ve host'u PATRON TEYİDİ BEKLİYOR (K-584619). Teyit olmadan doldurulmaz.
# Sertifika yolu konteyner yoludur (/app/certs); host psql'de ops.sh migrate bunu depo certs/ dizinine çevirir.
# DB-1 biçimi: postgresql://fabrika_app:<şifre>@<supabase-host>:5432/<veritabani>?sslmode=verify-full&sslrootcert=/app/certs/supabase-prod-ca-2021.crt
# Yerel prova (profile "db") için: postgresql://fabrika_app:<şifre>@postgres:5432/fabrika?schema=public
DATABASE_URL=
# Bağlantı zaman aşımı (src/lib/db.ts).
DB_CONNECT_TIMEOUT_MS=
# Yalnız RLS ölçümü için (scripts/setup-rls-role.ts, scripts/check-rls-live.ts). ops.sh rls-role bunu ister.
DATABASE_URL_RLS_TEST=
# Worker'ın graphile_worker şeması. DB-1 biçimi: postgresql://fabrika_jobs:<şifre>@<supabase-host>:5432/<veritabani>?sslmode=verify-full&sslrootcert=/app/certs/supabase-prod-ca-2021.crt
# (<supabase-host> yer tutucu: patron teyidi bekleniyor, yukarıdaki DATABASE_URL notuna bakın.) Yerel prova: postgres:5432.
# Rol: fabrika_jobs (CONNECT + CREATE ON DATABASE; BYPASSRLS yok). Boşsa worker DATABASE_URL'e düşer (fabrika_app
# şema kuramaz) — üretimde boş bırakma.
JOBS_DATABASE_URL=
# Worker'da zorunlu açık seçim. İlk kurulum: false → migrasyon sonra true (RELEASE_CHECKLIST §3.3).
JOBS_CRON_ENABLED=
JOBS_CONCURRENCY=

# --- Proxy / kanıt / sır ---
# Dosya taraması (NG-239, src/lib/clamav.ts). CLAMD_HOST: compose servis adı; yalnız iç ağ (loopback ya da özel ağ kuralı).
# Boşsa tarayıcı yoktur: kanıt dosyası indirilmez (fail closed).
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=60000
EXPERT_PREREG_IP_SALT=
# İlk e-postadan ÖNCE doldurun; bir daha değiştirmeyin (çıkış bağlantıları süresizdir, NG-42).
EMAIL_OPTOUT_SECRET=
CALENDAR_ENCRYPTION_KEY=
# NG-40: openssl rand -base64 32 — buyerVknTckn şifreleme anahtarı; yedekleyin, kaybolursa numaralar okunamaz.
TAX_ID_ENCRYPTION_KEY=

# --- E-posta: Hostinger posta (patron 31.10.2026, FO-260). Boşsa posta gitmez ve üretimde SystemAlert yazılır ---
# Sunucu adı ve gönderen genel bilgidir; parola SMTP_PASS yalnız sunucu .env / secret store'da.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@nexagrant.com
SMTP_PASS=
SMTP_FROM="NexaGrant <info@nexagrant.com>"
NEXT_PUBLIC_SMTP_FROM_ADDRESS=info@nexagrant.com
FEEDBACK_DIGEST_TO=

# --- Dosya deposu (Cloudflare R2; boşsa yüklemeler object_store_unconfigured ile reddedilir) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_HOST=
R2_REGION=
R2_ENDPOINT=

# --- YZ sağlayıcıları (patron: OPENAI anahtarını önce yenile, RELEASE_CHECKLIST §8 madde 7) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KEEP_EU_API_KEY=

# --- Python CORDIS servisi (src/lib/jobs/tasks/k2-monthly-cordis.ts). Yığında servis YOK (RUNBOOK §10); değerler boş kalır ---
WORKER_URL=
WORKER_TOKEN=
K1_EMBEDDING_MAX_USD_PER_RUN=

# --- Opsiyonel ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_CORDIS_WIDGET_KEY=
ALERTS_SWEEP_FAILURE_THRESHOLD=
PUBLIC_LEAD_STUCK_AFTER_MINUTES=
CONSORTIUM_LIVE_DEMAND_WEIGHT=
BETA_SUPPORT_EMAIL=
BETA_FEEDBACK_EMAIL=
TCMB_BASE_URL=
